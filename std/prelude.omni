// ==============================================================================
// OMNI PURE STANDARD LIBRARY — `std/prelude.omni`
// ==============================================================================
//
// Canonical Pure-Omni prelude imported via `include "std/prelude.omni";`.
// Provides verified integer clamping, absolute difference, ternary multiplexing,
// 3-way balanced ternary consensus, signum, and bounded linear interpolation.
// ==============================================================================

#[strict]
fn std_clamp(x: i64, lo: i64, hi: i64) -> i64 {
    let lower: i64 = imax(x, lo);
    let clamped: i64 = imin(lower, hi);
    return clamped;
}

#[strict]
fn std_abs_diff(a: i64, b: i64) -> i64 {
    let d: i64 = a - b;
    let r: i64 = iabs(d);
    return r;
}

#[strict]
fn std_trit_mux(cond: trit, neg_v: i64, zero_v: i64, pos_v: i64) -> i64 {
    let r: i64 = sel_trit(cond, neg_v, zero_v, pos_v);
    return r;
}

#[strict]
fn std_consensus3(s0: trit, s1: trit, s2: trit) -> trit {
    let m: trit = tmaj(s0, s1, s2);
    return m;
}
