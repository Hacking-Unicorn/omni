// ==============================================================================
// OMNI PURE STANDARD LIBRARY — `std/math.omni`
// ==============================================================================
//
// Total, trap-free 64-bit integer arithmetic utilities in Pure Omni:
// clamping, absolute difference, signum, linear scaling, and triangular sums.
// ==============================================================================

#[strict]
fn std_clamp(x: i64, lo: i64, hi: i64) -> i64 {
    let lower: i64 = imax(x, lo);
    let clamped: i64 = imin(lower, hi);
    return clamped;
}

#[strict]
fn std_abs_diff(a: i64, b: i64) -> i64 {
    let d: i64 = a - b;
    let r: i64 = iabs(d);
    return r;
}

#[strict]
fn std_signum(x: i64) -> i64 {
    let c: trit = x <=> 0;
    let s: i64 = sel_trit(c, -1, 0, 1);
    return s;
}

#[strict]
fn std_mad_clamped(x: i64, weight: i64, bias: i64, lo: i64, hi: i64) -> i64 {
    let raw: i64 = x * weight + bias;
    let lower: i64 = imax(raw, lo);
    let res: i64 = imin(lower, hi);
    return res;
}

#[strict]
fn std_sum_range(n: i64) -> i64 {
    let acc: i64 = 0;
    let i: i64 = 1;
    while i <= n {
        acc += i;
        i += 1;
    }
    return acc;
}
