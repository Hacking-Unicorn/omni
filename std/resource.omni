// ==============================================================================
// STDLIB MODULE: `std/resource.omni` — Linear Arena & Step/Memory Budget Helpers
// ==============================================================================
// High-level pure-Omni helpers for linear memory arena (`0x7E00`) scoped scoring,
// chunk capacity calculation, and execution budget (`#[step_budget]`, `#[mem_budget]`) headroom.

#[strict]
fn std_arena_scoped_score(base: i64, weight: i64, offset: i64) -> i64 {
    let a_scope: arena = arena(1024);
    let r_view: i64 = borrow_r(a_scope);
    let prod: i64 = base * weight;
    let total: i64 = prod + offset + (r_view * 0);
    drop(r_view);
    drop(a_scope);
    return total;
}

#[strict]
fn std_budget_headroom(used_units: i64, limit_units: i64) -> i64 {
    let raw_rem: i64 = limit_units - used_units;
    let clamped: i64 = imax(raw_rem, 0);
    return clamped;
}

#[strict]
fn std_budget_is_within(used_units: i64, limit_units: i64, safety_margin: i64) -> trit {
    let effective_used: i64 = used_units + safety_margin;
    let cmp: trit = effective_used <= limit_units;
    return cmp;
}

#[strict]
fn std_arena_chunk_capacity(total_bytes: i64, chunk_size: i64) -> i64 {
    let valid_chunk: i64 = imax(chunk_size, 64);
    let chunks: i64 = total_bytes / valid_chunk;
    let clamped: i64 = imax(chunks, 1);
    return clamped;
}
