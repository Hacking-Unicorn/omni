include "std/prelude.omni";
macro weighted_diff(lhs, rhs, scale) = (lhs - rhs) * scale;
#[strict]
#[cap(AI)]
fn main(x: i64, lo: i64, hi: i64) -> i64 {
    let c: i64 = std_clamp(x, lo, hi);
    let d: i64 = weighted_diff(c, lo, 3);
    let g: trit = egate(d - 50);
    let bonus: i64 = std_trit_mux(g, -10, 0, 10);
    return d + bonus;
}