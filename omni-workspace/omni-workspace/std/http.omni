// ==============================================================================
// OMNI PURE STANDARD LIBRARY — `std/http.omni`
// ==============================================================================
//
// Pure-Omni HTTP/1.1 status classification, route method encoding, and response
// framing helpers for the capability-gated `OmniNarrowHost` runtime.
// ==============================================================================

#[strict]
fn std_http_is_success(status: i64) -> trit {
    let ge_200: trit = status >= 200;
    let lt_300: trit = status < 300;
    let ok: trit = tand(ge_200, lt_300);
    return ok;
}

#[strict]
fn std_http_pack_response(status: i64, payload: i64) -> i64 {
    let valid_cmp: trit = status >= 100;
    let code: i64 = if_pos valid_cmp { status } else { 500 };
    return code * 1000000 + payload;
}

#[strict]
fn std_http_route_score(method_code: i64, param_id: i64) -> i64 {
    let m_cmp: trit = method_code <=> 1;
    let method_bonus: i64 = match_trit m_cmp {
        neg => 400,
        zero => 200,
        pos => 201
    };
    return method_bonus * 1000000 + param_id;
}
