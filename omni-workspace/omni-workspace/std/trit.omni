// ==============================================================================
// OMNI PURE STANDARD LIBRARY — `std/trit.omni`
// ==============================================================================
//
// Balanced ternary (`{-1t, 0t, +1t}`) logic, consensus voting, and `@PACK5`
// radix-3 (`5 trits per byte`, `0..=242`) vector helpers in Pure Omni.
// ==============================================================================

#[strict]
fn std_trit_mux(cond: trit, neg_v: i64, zero_v: i64, pos_v: i64) -> i64 {
    let r: i64 = sel_trit(cond, neg_v, zero_v, pos_v);
    return r;
}

#[strict]
fn std_consensus3(s0: trit, s1: trit, s2: trit) -> trit {
    let m: trit = tmaj(s0, s1, s2);
    return m;
}

#[strict]
fn std_trit_quorum5(t0: trit, t1: trit, t2: trit, t3: trit, t4: trit) -> trit {
    let left: trit = tmaj(t0, t1, t2);
    let right: trit = tmaj(t2, t3, t4);
    let out: trit = tmaj(left, t2, right);
    return out;
}

#[strict]
fn std_trit_score(t0: trit, t1: trit, t2: trit, weight: i64) -> i64 {
    let m: trit = tmaj(t0, t1, t2);
    let base: i64 = sel_trit(m, -100, 0, 100);
    return base * weight;
}
