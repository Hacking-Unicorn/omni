// M2 lint positive fixture: bytes threaded linearly, 2-op IGET only on an array,
// constant divisor, one ANEW, acyclic calls.
fn add1(x: i64) -> i64 { let r: i64 = x + 1; return r; }
fn put(b: bytes, v: i64) -> bytes { let w: bytes = iset(b, v); return w; }
fn main(arr: array, n: i64) -> i64 {
    let b: bytes = anew(0);
    let i: i64 = 0;
    while i < n {
        let t: i64 = iget(arr, i);
        b = put(b, t);
        i = add1(i);
    }
    let len: i64 = slen(b);
    let q: i64 = len / 2;
    return q;
}
