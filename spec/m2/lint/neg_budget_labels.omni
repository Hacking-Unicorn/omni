// L11 BUDGET: 5 while loops = 15 labels > 12 (frontend cap 15 until C4; assembly cap 16).
fn main(n: i64) -> i64 {
    let acc: i64 = 0;
    let i0: i64 = 0;
    while i0 < n { acc = acc + 1; i0 = i0 + 1; }
    let i1: i64 = 0;
    while i1 < n { acc = acc + 2; i1 = i1 + 1; }
    let i2: i64 = 0;
    while i2 < n { acc = acc + 3; i2 = i2 + 1; }
    let i3: i64 = 0;
    while i3 < n { acc = acc + 4; i3 = i3 + 1; }
    let i4: i64 = 0;
    while i4 < n { acc = acc + 5; i4 = i4 + 1; }
    return acc;
}
