// Seed-Shrink Phase B4 harness for `pure/m5/launcher.omni`.
// Exposes 4-param `main` returning the 181-byte standalone Linux x86-64 launcher ELF64.

#[strict]
fn main(arena: bytes, a: i64, b: i64, c: i64) -> bytes {
    let w: bytes = m5l_emit_launcher_elf(arena);
    let n: i64 = ld_u64(w, m2l_regs());
    let keep: i64 = (a + b + c) * 0;
    return ret_slice(w, m2l_out() + keep, n);
}
