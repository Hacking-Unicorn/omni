#[strict]
#[cap(AI)]
fn pack5_trit_vec_golden() -> i64 {
    let v: trit_vec = [+1t, -1t, 0t, +1t, +1t, -1t, 0t, -1t, +1t, +1t];
    let packed: bytes = pack5(v);
    let packed_byte_len: i64 = slen(packed);
    let first_pack5_byte: i64 = iget(packed, 0);
    let second_pack5_byte: i64 = iget(packed, 1);
    let dot: i64 = tdot(v, v);
    let gate: trit = egate(v);
    let res: i64 = packed_byte_len * 1000 + first_pack5_byte + second_pack5_byte + dot + gate;
    return res;
}