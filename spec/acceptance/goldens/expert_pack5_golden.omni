// Stage 1 positive golden: `@PACK5` expert routing score (`(expert_id << 8) | (score + 5)`).
#[strict]
fn div3_q(v: i64) -> i64 {
    let q: i64 = 0;
    let r: i64 = v;
    while r >= 3 {
        r = r - 3;
        q = q + 1;
    }
    return q;
}

#[strict]
fn unpack5(packed: i64, idx: i64) -> i64 {
    let cur: i64 = packed;
    let k: i64 = 0;
    while k < idx {
        cur = div3_q(cur);
        k = k + 1;
    }
    let q: i64 = div3_q(cur);
    return (cur - q * 3) - 1;
}

#[strict]
fn main(expert_id: i64, packed_trits: i64) -> i64 {
    let score: i64 = 0;
    let i: i64 = 0;
    while i < 5 {
        score = score + unpack5(packed_trits, i);
        i = i + 1;
    }
    return (expert_id << 8) | ((score + 5) & 255);
}
