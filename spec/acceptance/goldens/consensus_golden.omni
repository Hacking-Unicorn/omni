// Stage 1 positive golden: weighted balanced-ternary consensus over 5-trit `@PACK5` bytes.
#[strict]
fn div3_q(v: i64) -> i64 {
    let q: i64 = 0;
    let r: i64 = v;
    while r >= 3 {
        r = r - 3;
        q = q + 1;
    }
    return q;
}

#[strict]
fn unpack5(packed: i64, idx: i64) -> i64 {
    let cur: i64 = packed;
    let k: i64 = 0;
    while k < idx {
        cur = div3_q(cur);
        k = k + 1;
    }
    let q: i64 = div3_q(cur);
    return (cur - q * 3) - 1;
}

#[strict]
fn main(votes_packed: i64, weights_packed: i64) -> trit {
    let acc: i64 = 0;
    let i: i64 = 0;
    while i < 5 {
        acc = acc + unpack5(votes_packed, i) * unpack5(weights_packed, i);
        i = i + 1;
    }
    return acc <=> 0;
}
