+/// `fe-dump lock` | `fe-dump tokens|stream <file.omni> <out.bin> [--strict]` (M3-01).
+/// `tokens` writes the canonical token dump; `stream` writes the u16 stream, then
+/// `<out.bin>.sm` with the sourcemap dump. Both as little-endian u16 words.
+/// Includes are resolved the same way as an in-memory compile (built-in modules, then the cwd).
+pub fn run_m3_fe_dump_cli(argv: &[String]) -> i32 {
+    let strict = argv.iter().any(|a| a == "--strict");
+    let rest: Vec<&String> = argv.iter().filter(|a| a.as_str() != "--strict").collect();
+    match rest.first().map(|s| s.as_str()) {
+        Some("lock") => match m3_fe_lock_rows() {
+            Ok(rows) => {
+                println!("# {} lock rows: name, strict, tok=words:fnv1a64:tokv=span-free words:fnv1a64 | ERR:CLASS:line:col, out=words:fnv1a64:sm=words:fnv1a64 | ERR:CLASS:line:col", M3_FE_DUMP_VERSION);
+                for r in rows {
+                    println!("{}", r);
+                }
+                0
+            }
+            Err(e) => {
+                eprintln!("[FE-DUMP FAIL] {}", e);
+                1
+            }
+        },
+        Some(mode @ ("tokens" | "stream")) if rest.len() >= 3 => {
+            let src = match fs::read_to_string(rest[1].as_str()) {
+                Ok(s) => s,
+                Err(e) => {
+                    eprintln!("[FE-DUMP FAIL] cannot read '{}': {}", rest[1], e);
+                    return 1;
+                }
+            };
+            let res = if mode == "tokens" {
+                m3_dump_tokens(&src, strict).map(|t| (t, None))
+            } else {
+                m3_dump_stream(&src, strict).map(|(s, sm)| (s, Some(sm)))
+            };
+            match res {
+                Ok((words, sm)) => {
+                    if let Err(e) = fs::write(rest[2].as_str(), encode_u16_stream_to_bytes(&words)) {
+                        eprintln!("[FE-DUMP FAIL] write: {}", e);
+                        return 1;
+                    }
+                    let mut msg = format!("[FE-DUMP] {} {} words={}", mode, rest[1], m3_words_fnv(&words));
+                    if let Some(smw) = sm {
+                        let p = format!("{}.sm", rest[2]);
+                        if let Err(e) = fs::write(&p, encode_u16_stream_to_bytes(&smw)) {
+                            eprintln!("[FE-DUMP FAIL] write: {}", e);
+                            return 1;
+                        }
+                        msg.push_str(&format!(" sm={}", m3_words_fnv(&smw)));
+                    }
+                    println!("{}", msg);
+                    0
+                }
+                Err(e) => {
+                    println!("[FE-DUMP] {} {} ERR:{}", mode, rest[1], m3_error_key(&e));
+                    1
+                }
+            }
+        }
+        _ => {
+            eprintln!("usage: fe-dump lock | fe-dump (tokens|stream) <file.omni> <out.bin> [--strict]");
+            2
+        }
+    }
+}
