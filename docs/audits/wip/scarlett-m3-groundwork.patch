+fn m3_push_u32(out: &mut Vec<u16>, v: usize) -> Result<(), String> {
+    if v > u32::MAX as usize {
+        return Err(format!("fe-dump value {} exceeds u32", v));
+    }
+    out.push((v & 0xFFFF) as u16);
+    out.push(((v >> 16) & 0xFFFF) as u16);
+    Ok(())
+}
