+            if ins.op_tok == 0x7F0F
+                && ins.operands.len() == 4
+                && (ins.operands[1] == BinOperand::ImmInt(-2) || ins.operands[1] == BinOperand::ImmInt(-4))
+            {
+                return Err(format!(
+                    "frozen stream '{name}' fn {fi} ins {ii} has 4-op ISET -2/-4 (new patch shape must not appear in locked streams)"
+                ));
+            }
+        }
+    }
+    Ok(())
