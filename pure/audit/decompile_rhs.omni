#[strict]
fn dc_in_off() -> i64 { return 266240; }
#[strict]
fn dc_ins_tbl() -> i64 { return 250000; }
#[strict]
fn dc_u16(w: bytes,wi: i64) -> i64 { return ld_u16(w,dc_in_off() + (wi << 1)); }
#[strict]
fn dc_skip_op1(w: bytes,nwords: i64,pos: i64) -> i64 {
let t: i64 = dc_u16(w,pos);
let is_2: i64 = m2u_eq(t,32485) + m2u_in(t,32491,32493);
let is_3: i64 = m2u_eq(t,32486);
let is_eng: i64 = m2u_eq(t,32490);
let elen: i64 = m2u_sel(is_eng * m2u_lt(pos + 1,nwords),dc_u16(w,pos + 1),0);
return pos + m2u_sel(is_2,2,m2u_sel(is_3,3,m2u_sel(is_eng,2 + elen,1)));
}
#[strict]
fn dc_skip_op(w: bytes,nwords: i64,pos: i64) -> i64 {
let p: i64 = pos;
let g: i64 = m2u_lt(p,nwords) * m2u_eq(dc_u16(w,p),32494);
while g <=> 0 {
p = p + 2;
g = m2u_lt(p,nwords) * m2u_eq(dc_u16(w,p),32494);
}
return dc_skip_op1(w,nwords,p);
}
#[strict]
fn dc_imm_val(w: bytes,pos: i64) -> i64 {
let t: i64 = dc_u16(w,pos);
