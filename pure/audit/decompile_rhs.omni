}
#[strict]
fn dc_ins_woff(w: bytes,idx: i64) -> i64 { return ld_u64(w,dc_ins_tbl() + (idx << 5)); }
#[strict]
fn dc_ins_dest(w: bytes,idx: i64) -> i64 { return ld_u64(w,dc_ins_tbl() + (idx << 5) + 8); }
#[strict]
fn dc_ins_op(w: bytes,idx: i64) -> i64 { return ld_u64(w,dc_ins_tbl() + (idx << 5) + 16) & 65535; }
#[strict]
fn dc_ins_ty(w: bytes,idx: i64) -> i64 { return (ld_u64(w,dc_ins_tbl() + (idx << 5) + 16) >> 16) & 65535; }
#[strict]
fn dc_ins_nops(w: bytes,idx: i64) -> i64 { return (ld_u64(w,dc_ins_tbl() + (idx << 5) + 16) >> 32) & 65535; }
#[strict]
fn dc_ins_op0(w: bytes,idx: i64) -> i64 { return ld_u64(w,dc_ins_tbl() + (idx << 5) + 24) & 1048575; }
#[strict]
fn dc_ins_op1(w: bytes,idx: i64) -> i64 { return (ld_u64(w,dc_ins_tbl() + (idx << 5) + 24) >> 20) & 1048575; }
#[strict]
fn dc_ins_op2(w: bytes,idx: i64) -> i64 { return (ld_u64(w,dc_ins_tbl() + (idx << 5) + 24) >> 40) & 1048575; }
#[strict]
fn dc_ins_opk(w: bytes,idx: i64,k: i64) -> i64 {
let nwords: i64 = ld_u64(w,32);
let p: i64 = dc_ins_op0(w,idx);
let i: i64 = 0;
while k - i <=> 0 {
p = dc_skip_op(w,nwords,p);
i = i + 1;
}
return p;
}
#[strict]
fn dc_parse_insns(arena: bytes,ip0: i64,icnt: i64) -> bytes {
let w: bytes = arena;
let nwords: i64 = ld_u64(w,32);
let ip: i64 = ip0;
let ii: i64 = 0;
while icnt - ii <=> 0 {
let t0: i64 = dc_u16(w,ip);
let hd: i64 = m2u_in(t0,32256,32447);
let dst: i64 = m2u_sel(hd,t0 - 32256,0 - 1);
let op: i64 = dc_u16(w,ip + hd);
let ty: i64 = m2u_sel(hd,dc_u16(w,ip + 2),32640);
let cur: i64 = ip + 1 + hd * 3;
let o0: i64 = cur;
let o1: i64 = cur;
let o2: i64 = cur;
let nops: i64 = 0;
let g: i64 = m2u_lt(cur,nwords) * (1 - m2u_eq(dc_u16(w,cur),32484));
while g <=> 0 {
o1 = m2u_sel(m2u_eq(nops,1),cur,o1);
o2 = m2u_sel(m2u_eq(nops,2),cur,o2);
cur = dc_skip_op(w,nwords,cur);
nops = nops + 1;
g = m2u_lt(cur,nwords) * (1 - m2u_eq(dc_u16(w,cur),32484));
}
let slot: i64 = dc_ins_tbl() + (ii << 5);
w = iset_patch_i64(w,slot,ip);
w = iset_patch_i64(w,slot + 8,dst);
w = iset_patch_i64(w,slot + 16,op | (ty << 16) | (nops << 32));
w = iset_patch_i64(w,slot + 24,o0 | (o1 << 20) | (o2 << 40));
ip = cur + 1;
ii = ii + 1;
}
return iset_patch_i64(w,160,ip);
}
#[strict]
fn dc_label_id(w: bytes,idx: i64,k: i64) -> i64 {
let ok_k: i64 = m2u_lt(k,dc_ins_nops(w,idx));
