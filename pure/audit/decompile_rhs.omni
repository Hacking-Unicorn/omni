#[strict]
fn dc_emit_rhs(arena: bytes,idx: i64) -> bytes {
let w: bytes = iset_patch_i64(arena,80,0);
let op: i64 = dc_ins_op(w,idx);
let p0: i64 = dc_ins_op0(w,idx);
let p1: i64 = dc_ins_op1(w,idx);
let p2: i64 = dc_ins_op2(w,idx);
let is_bin: i64 = m2u_in(op,32528,32532) + m2u_in(op,32542,32544) + m2u_in(op,32546,32551) + m2u_eq(op,32557);
let r: bytes = if_pos is_bin <=> 0 {
let u: bytes = dc_emit_op(iset_patch_i64(w,80,1),p0);
u = dc_binop_sym_c(dc_binop_sym_b(dc_binop_sym_a(u,op),op),op);
dc_emit_op(u,p1)
} else { if_pos m2u_in(op,32513,32527) <=> 0 { dc_rhs_g1(w,idx,op,p0) }
else { if_pos m2u_in(op,32533,32556) <=> 0 { dc_rhs_g2(w,op,p0,p1,p2) }
else { if_pos m2u_in(op,32560,32584) <=> 0 { dc_rhs_g3(w,idx,op,p0,p1,p2) }
else { if_pos m2u_in(op,32592,32605) <=> 0 { dc_rhs_g4(w,op,p0,p1) }
else { if_pos m2u_in(op,32612,32624) <=> 0 { dc_rhs_g5(w,op,p0,p1) }
else { w } } } } } };
return r;
}
#[strict]
fn dc_op_fixed_ty(op: i64) -> i64 {
let is_i64: i64 = m2u_in(op,32514,32515) + m2u_eq(op,32526) + m2u_in(op,32528,32536)
+ m2u_in(op,32542,32547) + m2u_eq(op,32564) + m2u_eq(op,32592) + m2u_in(op,32612,32624);
let is_trit: i64 = m2u_in(op,32548,32557) + m2u_eq(op,32565) + m2u_eq(op,32575);
let is_bytes: i64 = m2u_eq(op,32525) + m2u_eq(op,32527) + m2u_eq(op,32560);
let is_tvec: i64 = m2u_eq(op,32561);
let is_arena: i64 = m2u_eq(op,32513);
return is_i64 * 32641 + is_trit * 32643 + is_bytes * 32646 + is_tvec * 32647 + is_arena * 32650;
}
#[strict]
fn dc_can_rhs(w: bytes,idx: i64) -> i64 {
let op: i64 = dc_ins_op(w,idx);
let nops: i64 = dc_ins_nops(w,idx);
let p0: i64 = dc_ins_op0(w,idx);
let p1: i64 = dc_ins_op1(w,idx);
let is_bin: i64 = m2u_in(op,32528,32532) + m2u_in(op,32542,32544) + m2u_in(op,32546,32551) + m2u_eq(op,32557);
let is_1: i64 = m2u_in(op,32513,32515) + m2u_eq(op,32518)
+ m2u_eq(op,32525) + m2u_eq(op,32534) + m2u_eq(op,32545) + m2u_eq(op,32552)
+ m2u_eq(op,32560) + m2u_eq(op,32565) + m2u_eq(op,32592) + m2u_in(op,32597,32601)
+ m2u_eq(op,32605) + m2u_eq(op,32612) + m2u_eq(op,32616) + m2u_eq(op,32621) + m2u_eq(op,32624);
let is_const: i64 = m2u_eq(op,32521) * m2u_eq(nops,1) * m2u_in(dc_u16(w,p0),32485,32490);
let is_2: i64 = is_bin + m2u_eq(op,32535) + m2u_eq(op,32536) + m2u_in(op,32553,32555)
+ m2u_eq(op,32561) + m2u_eq(op,32564) + m2u_eq(op,32593) + m2u_eq(op,32613)
+ m2u_eq(op,32619) + m2u_eq(op,32622) + m2u_eq(op,32623);
let is_3: i64 = m2u_eq(op,32556) + m2u_eq(op,32575);
let is_4: i64 = m2u_eq(op,32581);
let is_call: i64 = m2u_eq(op,32584) * m2u_ge(nops,1) * m2u_eq(dc_u16(w,p0),32492);
let is_iset: i64 = m2u_eq(op,32527) * m2u_ge(nops,2);
let ig_w: i64 = m2u_sel(dc_is_imm(w,p1),dc_imm_val(w,p1),0);
let ig_ok3: i64 = m2u_eq(nops,3) * dc_is_imm(w,p1)
* (m2u_eq(ig_w,0 - 1) + m2u_eq(ig_w,0 - 2) + m2u_eq(ig_w,0 - 4) + m2u_eq(ig_w,0 - 8));
let is_iget: i64 = m2u_eq(op,32526) * (m2u_eq(nops,2) + ig_ok3);
let ok: i64 = (is_1 * m2u_eq(nops,1)) + (is_2 * m2u_eq(nops,2)) + (is_3 * m2u_eq(nops,3))
+ (is_4 * m2u_eq(nops,4)) + is_const + is_call + is_iset + is_iget;
let want_ty: i64 = dc_op_fixed_ty(op);
let ty_ok: i64 = m2u_eq(want_ty,0) + m2u_eq(dc_ins_ty(w,idx),want_ty);
return m2u_lt(0,ok) * m2u_lt(0,ty_ok);
}
