let is_i: i64 = dc_is_imm(w,p) * ok_k;
return m2u_sel(is_l,t - 32496,m2u_sel(is_i,dc_imm_val(w,p) & 65535,0 - 1));
}
#[strict]
fn dc_find_label(w: bytes,start: i64,end: i64,lbl: i64) -> i64 {
let k: i64 = start;
let found: i64 = 0 - 1;
let g: i64 = m2u_lt(k,end);
while g <=> 0 {
let hit: i64 = m2u_eq(dc_ins_op(w,k),32576) * m2u_eq(dc_label_id(w,k,0),lbl);
found = m2u_sel(hit,k,found);
k = k + 1;
g = (1 - hit) * m2u_lt(k,end);
}
return found;
}
