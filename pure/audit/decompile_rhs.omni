m2u_sel(m2u_eq(k,1),dc_ins_op1(w,idx),
m2u_sel(m2u_eq(k,2),dc_ins_op2(w,idx),dc_ins_opk(w,idx,k))));
let t: i64 = m2u_sel(ok_k,dc_u16(w,p),0);
