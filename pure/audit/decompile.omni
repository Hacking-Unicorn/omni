#[strict]
fn dc_count_fns(w: bytes,nwords: i64) -> i64 {
let nfns: i64 = 0;
let cp: i64 = 1;
let cg: i64 = m2u_lt(cp,nwords - 1);
while cg <=> 0 {
let tag: i64 = dc_u16(w,cp);
let is_fn: i64 = m2u_eq(tag,32483);
let is_sch: i64 = m2u_eq(tag,32481);
let is_exp: i64 = m2u_eq(tag,32482);
let is_end: i64 = m2u_eq(tag,32495);
nfns = nfns + is_fn;
cp = if_pos is_fn <=> 0 {
let pcnt: i64 = dc_u16(w,cp + 2);
let sig: i64 = cp + 3 + pcnt * 3;
let icnt: i64 = dc_u16(w,sig + 2);
let ip: i64 = sig + 3;
let ii: i64 = 0;
while icnt - ii <=> 0 {
let hd: i64 = m2u_in(dc_u16(w,ip),32256,32447);
let cur: i64 = ip + 1 + hd * 3;
let gi: i64 = m2u_lt(cur,nwords) * (1 - m2u_eq(dc_u16(w,cur),32484));
while gi <=> 0 {
cur = dc_skip_op(w,nwords,cur);
gi = m2u_lt(cur,nwords) * (1 - m2u_eq(dc_u16(w,cur),32484));
}
ip = cur + 1;
ii = ii + 1;
}
ip
} else {
let sn: i64 = m2u_sel(is_sch,dc_u16(w,cp + 2),0);
m2u_sel(is_end,nwords,m2u_sel(is_sch,cp + 3 + sn * 2,m2u_sel(is_exp,cp + 5,cp + 1)))
};
cg = (1 - is_end) * m2u_lt(cp,nwords - 1);
}
return nfns;
}
