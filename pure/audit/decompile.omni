// ==============================================================================
// pure/audit/decompile.omni (Step 7) — Pure-Omni Deterministic M3 Decompiler
// ==============================================================================
// Pure-Omni port of `m2_host/audit_view.rs` (`decompile_u16_stream_to_m3`).
// Compiled by `m3.elf` + `m2.elf` into a standalone Linux x86-64 ELF64
// (`audit_decompile.elf`) with zero Rust.
//
// Usage:
//   audit_decompile.elf <in.omni_bc>
//
// Arena layout (512 KiB):
//   0      .. 511    : sys_util state (0=out_len, 8=argc, 32=nwords, 40=hash, 48=nfns, 56=nexact, 64=napprox, 72=cur_approx)
//   512    .. 1023   : argv table (32 x 16 B)
//   2048   .. 4095   : /proc/self/cmdline
//   4096   .. 266239 : Band A (output M3 text buffer, 256 KiB)
//   266240 .. 524287 : Band B (input .omni_bc raw bytes, up to 252 KiB)
// ==============================================================================

include "../m2/util.omni";
include "../driver/sys_util.omni";

#[strict]
fn dc_in_off() -> i64 { return 266240; }

#[strict]
fn dc_u16(arena: bytes, wi: i64) -> i64 {
    return ld_u16(arena, dc_in_off() + (wi << 1));
}

#[strict]
fn dc_skip_op1(arena: bytes, nwords: i64, pos: i64) -> i64 {
    let t: i64 = dc_u16(arena, pos);
    let is_2: i64 = m2u_eq(t, 32485) + m2u_in(t, 32491, 32493);
    let is_3: i64 = m2u_eq(t, 32486);
    let is_eng: i64 = m2u_eq(t, 32490);
    let elen: i64 = m2u_sel(is_eng * m2u_lt(pos + 1, nwords), dc_u16(arena, pos + 1), 0);
    return pos + m2u_sel(is_2, 2, m2u_sel(is_3, 3, m2u_sel(is_eng, 2 + elen, 1)));
}

#[strict]
fn dc_skip_op(arena: bytes, nwords: i64, pos: i64) -> i64 {
    let p: i64 = pos;
    let g: i64 = m2u_lt(p, nwords) * m2u_eq(dc_u16(arena, p), 32494);
    while g <=> 0 {
        p = p + 2;
        g = m2u_lt(p, nwords) * m2u_eq(dc_u16(arena, p), 32494);
    }
    return dc_skip_op1(arena, nwords, p);
}

#[strict]
fn dc_imm_val(arena: bytes, pos: i64) -> i64 {
    let t: i64 = dc_u16(arena, pos);
    let v16: i64 = m2u_sext16(dc_u16(arena, pos + 1));
    let v32: i64 = m2u_sext32((dc_u16(arena, pos + 1) << 16) | dc_u16(arena, pos + 2));
    return m2u_sel(m2u_eq(t, 32485), v16, m2u_sel(m2u_eq(t, 32486), v32, 0));
}

#[strict]
fn dc_emit_ty_hi(w: bytes, ty: i64) -> bytes {
    let r: bytes = if_pos m2u_eq(ty, 32647) <=> 0 { su_out4(su_out4(w, 116, 114, 105, 116), 95, 118, 101, 99) }
    else { if_pos m2u_eq(ty, 32649) <=> 0 { su_out4(su_out_u8(w, 97), 114, 114, 97, 121) }
    else { if_pos m2u_eq(ty, 32650) <=> 0 { su_out4(su_out_u8(w, 97), 114, 101, 110, 97) }
    else { if_pos m2u_eq(ty, 32640) <=> 0 { su_out4(w, 118, 111, 105, 100) }
    else {
        let u: bytes = iset_patch_i64(w, 72, 1);
        su_out4(u, 105, 54, 52, 0)
    } } } };
    return r;
}

// Emits a type name for `ty_tok` (sets `arena[72]=1` for APPROXIMATE if unknown).
#[strict]
fn dc_emit_ty(arena: bytes, ty: i64) -> bytes {
    let w: bytes = arena;
    let r: bytes = if_pos m2u_eq(ty, 32641) <=> 0 { su_out4(w, 105, 54, 52, 0) }
    else { if_pos m2u_eq(ty, 32643) <=> 0 { su_out4(w, 116, 114, 105, 116) }
    else { if_pos m2u_eq(ty, 32644) <=> 0 { su_out4(w, 115, 116, 114, 0) }
    else { if_pos m2u_eq(ty, 32646) <=> 0 { su_out4(su_out_u8(w, 98), 121, 116, 101, 115) }
    else { dc_emit_ty_hi(w, ty) } } } };
    return r;
}

#[strict]
fn dc_emit_op_hi(arena: bytes, pos: i64, t: i64) -> bytes {
    let r: bytes = if_pos m2u_eq(t, 32488) <=> 0 {
        su_out4(arena, 48, 116, 0, 0)
    } else { if_pos m2u_eq(t, 32489) <=> 0 {
        su_out4(arena, 43, 49, 116, 0)
    } else { if_pos m2u_eq(t, 32492) <=> 0 {
        su_out_i64(su_out4(arena, 102, 110, 95, 0), dc_u16(arena, pos + 1))
    } else { if_pos m2u_in(t, 32496, 32511) <=> 0 {
        su_out_i64(arena, t - 32496)
    } else {
        su_out_hex(arena, t, 4)
    } } } };
    return r;
}

// Emits one formatted operand at word `pos` (`vN`, `pN`, imm int, trit `-1t`/`0t`/`+1t`, `fn_N`, label).
#[strict]
fn dc_emit_op(arena: bytes, pos: i64) -> bytes {
    let t: i64 = dc_u16(arena, pos);
    let r: bytes = if_pos m2u_in(t, 32256, 32447) <=> 0 {
        su_out_i64(su_out_u8(arena, 118), t - 32256)
    } else { if_pos m2u_in(t, 32448, 32479) <=> 0 {
        su_out_i64(su_out_u8(arena, 112), t - 32448)
    } else { if_pos m2u_in(t, 32485, 32486) <=> 0 {
        su_out_i64(arena, dc_imm_val(arena, pos))
    } else { if_pos m2u_eq(t, 32487) <=> 0 {
        su_out4(arena, 45, 49, 116, 0)
    } else { dc_emit_op_hi(arena, pos, t) } } } };
    return r;
}

#[strict]
fn dc_emit_binop_sym_a(u: bytes, op: i64) -> bytes {
    let r: bytes = if_pos m2u_eq(op, 32528) <=> 0 { su_out4(u, 32, 43, 32, 0) }
    else { if_pos m2u_eq(op, 32529) <=> 0 { su_out4(u, 32, 45, 32, 0) }
    else { if_pos m2u_eq(op, 32530) <=> 0 { su_out4(u, 32, 42, 32, 0) }
    else { if_pos m2u_eq(op, 32531) <=> 0 { su_out4(u, 32, 47, 32, 0) }
    else { if_pos m2u_eq(op, 32532) <=> 0 { su_out4(u, 32, 37, 32, 0) }
    else { u } } } } };
    return r;
}

#[strict]
fn dc_emit_binop_sym_b(u: bytes, op: i64) -> bytes {
    let r: bytes = if_pos m2u_eq(op, 32542) <=> 0 { su_out4(u, 32, 38, 32, 0) }
    else { if_pos m2u_eq(op, 32543) <=> 0 { su_out4(u, 32, 124, 32, 0) }
    else { if_pos m2u_eq(op, 32544) <=> 0 { su_out4(u, 32, 94, 32, 0) }
    else { if_pos m2u_eq(op, 32546) <=> 0 { su_out4(u, 32, 60, 60, 32) }
    else { if_pos m2u_eq(op, 32547) <=> 0 { su_out4(u, 32, 62, 62, 32) }
    else { u } } } } };
    return r;
}

#[strict]
fn dc_emit_binop_sym_c(u: bytes, op: i64) -> bytes {
    let r: bytes = if_pos m2u_eq(op, 32548) <=> 0 { su_out4(u, 32, 61, 61, 32) }
    else { if_pos m2u_eq(op, 32549) <=> 0 { su_out4(u, 32, 33, 61, 32) }
    else { if_pos m2u_eq(op, 32550) <=> 0 { su_out4(u, 32, 60, 32, 0) }
    else { if_pos m2u_eq(op, 32551) <=> 0 { su_out4(u, 32, 62, 32, 0) }
    else { if_pos m2u_eq(op, 32557) <=> 0 { su_out4(su_out_u8(u, 32), 60, 61, 62, 32) }
    else { u } } } } };
    return r;
}

// Emits binary operator RHS (`p0 <op> p1`) for ALU/bitwise/cmp/trit opcodes. Sets `arena[80]=1` if handled.
#[strict]
fn dc_emit_binop(arena: bytes, op: i64, p0: i64, p1: i64) -> bytes {
    let w: bytes = iset_patch_i64(arena, 80, 0);
    let is_bin: i64 = m2u_in(op, 32528, 32532) + m2u_in(op, 32542, 32544) + m2u_in(op, 32546, 32551) + m2u_eq(op, 32557);
    let r: bytes = if_pos is_bin <=> 0 {
        let u: bytes = dc_emit_op(iset_patch_i64(w, 80, 1), p0);
        u = dc_emit_binop_sym_a(u, op);
        u = dc_emit_binop_sym_b(u, op);
        u = dc_emit_binop_sym_c(u, op);
        dc_emit_op(u, p1)
    } else { w };
    return r;
}

#[strict]
fn dc_emit_rhs_ext(u: bytes, nwords: i64, op: i64, p0: i64, p1: i64, p2: i64, p3: i64) -> bytes {
    let r: bytes = if_pos (m2u_eq(op, 32518) + m2u_eq(op, 32520) + m2u_eq(op, 32521)) <=> 0 {
        dc_emit_op(u, p0)
    } else { if_pos m2u_eq(op, 32525) <=> 0 {
        su_out_u8(dc_emit_op(su_out4(su_out_u8(u, 97), 110, 101, 119, 40), p0), 41)
    } else { if_pos m2u_eq(op, 32581) <=> 0 {
        let s: bytes = su_out4(su_out4(su_out_u8(u, 115), 101, 108, 95, 116), 114, 105, 116, 40);
        s = dc_emit_op(su_out4(dc_emit_op(s, p0), 44, 32, 0, 0), p1);
        s = dc_emit_op(su_out4(s, 44, 32, 0, 0), p2);
        su_out_u8(dc_emit_op(su_out4(s, 44, 32, 0, 0), p3), 41)
    } else { if_pos m2u_eq(op, 32584) <=> 0 {
        let s: bytes = su_out_u8(dc_emit_op(u, p0), 40);
        let cur: i64 = p1;
        let first: i64 = 1;
        let gc: i64 = m2u_lt(cur, nwords) * (1 - m2u_eq(dc_u16(s, cur), 32484));
        while gc <=> 0 {
            s = if_pos (1 - first) <=> 0 { su_out4(s, 44, 32, 0, 0) } else { s };
            s = dc_emit_op(s, cur);
            cur = dc_skip_op(s, nwords, cur);
            first = 0;
            gc = m2u_lt(cur, nwords) * (1 - m2u_eq(dc_u16(s, cur), 32484));
        }
        su_out_u8(s, 41)
    } else {
        let s: bytes = iset_patch_i64(u, 72, 1);
        su_out4(su_out_hex(su_out4(su_out4(su_out4(s, 47, 42, 32, 91), 76, 73, 84, 69), 82, 65, 76, 32), op, 4), 93, 32, 42, 47)
    } } } };
    return r;
}

// Emits a single instruction line into Band A (with 4-space indent).
#[strict]
fn dc_emit_ins(arena: bytes, nwords: i64, ip: i64) -> bytes {
    let w: bytes = su_out4(arena, 32, 32, 32, 32);
    let t0: i64 = dc_u16(w, ip);
    let has_d: i64 = m2u_in(t0, 32256, 32447);
    let op: i64 = dc_u16(w, ip + has_d);
    let ty: i64 = m2u_sel(has_d, dc_u16(w, ip + 2), 32640);
    let p0: i64 = ip + 1 + has_d * 3;
    let p1: i64 = dc_skip_op(w, nwords, p0);
    let p2: i64 = dc_skip_op(w, nwords, p1);
    let p3: i64 = dc_skip_op(w, nwords, p2);
    let r: bytes = if_pos m2u_eq(op, 32586) <=> 0 {
        let is3: i64 = (1 - m2u_eq(dc_u16(w, p1), 32484)) * (1 - m2u_eq(dc_u16(w, p2), 32484));
        let u: bytes = su_out4(su_out4(w, 114, 101, 116, 117), 114, 110, 32, 0);
        if_pos is3 <=> 0 {
            let s: bytes = su_out4(su_out4(su_out4(u, 114, 101, 116, 95), 115, 108, 105, 99), 101, 40, 0, 0);
            s = dc_emit_op(su_out4(dc_emit_op(s, p0), 44, 32, 0, 0), p1);
            su_out4(dc_emit_op(su_out4(s, 44, 32, 0, 0), p2), 41, 59, 10, 0)
        } else {
            su_out4(dc_emit_op(u, p0), 59, 10, 0, 0)
        }
    } else { if_pos has_d <=> 0 {
        let u: bytes = su_out4(w, 108, 101, 116, 32);
        u = su_out4(su_out_i64(su_out_u8(u, 118), t0 - 32256), 58, 32, 0, 0);
        u = su_out4(dc_emit_ty(u, ty), 32, 61, 32, 0);
        u = dc_emit_binop(u, op, p0, p1);
        let u2: bytes = if_pos ld_u64(u, 80) <=> 0 { u } else { dc_emit_rhs_ext(u, nwords, op, p0, p1, p2, p3) };
        su_out4(u2, 59, 10, 0, 0)
    } else {
        let s: bytes = iset_patch_i64(w, 72, 1);
        su_out4(su_out_hex(su_out4(su_out4(su_out4(s, 47, 47, 32, 91), 76, 73, 84, 69), 82, 65, 76, 32), op, 4), 93, 10, 0, 0)
    } };
    return r;
}

// Emits one complete function block and advances `arena[88]` to next word pos.
#[strict]
fn dc_emit_fn(arena: bytes, nwords: i64, pos: i64, pos_idx: i64, nfns: i64) -> bytes {
    let w: bytes = iset_patch_i64(arena, 72, 0);
    let fid: i64 = dc_u16(w, pos + 1);
    let pcnt: i64 = dc_u16(w, pos + 2);
    let sig: i64 = pos + 3 + pcnt * 3;
    let ret_ty: i64 = dc_u16(w, sig);
    let cmask: i64 = dc_u16(w, sig + 1);
    let icnt: i64 = dc_u16(w, sig + 2);
    // Emit #[strict] + optional #[fn_id(fid)] + fn fn_<fid>(...) -> <ret_ty> {
    w = su_out4(su_out4(su_out4(w, 35, 91, 115, 116), 114, 105, 99, 116), 93, 10, 0, 0);
    let exp_id: i64 = m2u_sel(m2u_eq(nfns, 1), 0, m2u_sel(m2u_eq(pos_idx + 1, nfns), 0, pos_idx + 1));
    w = if_pos (1 - m2u_eq(fid, exp_id)) <=> 0 {
        su_out4(su_out_i64(su_out4(su_out4(w, 35, 91, 102, 110), 95, 105, 100, 40), fid), 41, 93, 10, 0)
    } else { w };
    w = su_out_u8(su_out_i64(su_out4(su_out4(w, 102, 110, 32, 102), 110, 95, 0, 0), fid), 40);
    let pk: i64 = 0;
    while pcnt - pk <=> 0 {
        w = if_pos pk <=> 0 { su_out4(w, 44, 32, 0, 0) } else { w };
        let pt: i64 = dc_u16(w, pos + 3 + pk * 3);
        let pty: i64 = dc_u16(w, pos + 3 + pk * 3 + 1);
        w = dc_emit_ty(su_out4(su_out_i64(su_out_u8(w, 112), pt - 32448), 58, 32, 0, 0), pty);
        pk = pk + 1;
    }
    w = su_out4(dc_emit_ty(su_out4(su_out4(w, 41, 32, 45, 62), 32, 0, 0, 0), ret_ty), 32, 123, 10, 0);
    let ip: i64 = sig + 3;
    let ii: i64 = 0;
    while icnt - ii <=> 0 {
        w = dc_emit_ins(w, nwords, ip);
        let cur: i64 = ip + 1 + m2u_in(dc_u16(w, ip), 32256, 32447) * 3;
        let gi: i64 = m2u_lt(cur, nwords) * (1 - m2u_eq(dc_u16(w, cur), 32484));
        while gi <=> 0 {
            cur = dc_skip_op(w, nwords, cur);
            gi = m2u_lt(cur, nwords) * (1 - m2u_eq(dc_u16(w, cur), 32484));
        }
        ip = cur + 1;
        ii = ii + 1;
    }
    w = su_out4(w, 125, 10, 0, 0);
    let approx: i64 = ld_u64(w, 72);
    w = iset_patch_i64(w, 56, ld_u64(w, 56) + (1 - approx));
    w = iset_patch_i64(w, 64, ld_u64(w, 64) + approx);
    return iset_patch_i64(w, 88, ip + cmask * 0);
}

// Counts functions in the validated `.omni_bc` stream in Band B.
#[strict]
fn dc_count_fns(w: bytes, nwords: i64) -> i64 {
    let nfns: i64 = 0;
    let pos: i64 = 1;
    let g1: i64 = m2u_lt(pos, nwords - 1);
    while g1 <=> 0 {
        let tag: i64 = dc_u16(w, pos);
        let is_fn: i64 = m2u_eq(tag, 32483);
        let is_end: i64 = m2u_eq(tag, 32495);
        if_pos is_fn <=> 0 {
            nfns = nfns + 1;
            let pcnt: i64 = dc_u16(w, pos + 2);
            let sig: i64 = pos + 3 + pcnt * 3;
            let icnt: i64 = dc_u16(w, sig + 2);
            let ip: i64 = sig + 3;
            let ii: i64 = 0;
            while icnt - ii <=> 0 {
                let cur: i64 = ip + 1 + m2u_in(dc_u16(w, ip), 32256, 32447) * 3;
                let gi: i64 = m2u_lt(cur, nwords) * (1 - m2u_eq(dc_u16(w, cur), 32484));
                while gi <=> 0 {
                    cur = dc_skip_op(w, nwords, cur);
                    gi = m2u_lt(cur, nwords) * (1 - m2u_eq(dc_u16(w, cur), 32484));
                }
                ip = cur + 1;
                ii = ii + 1;
            }
            pos = ip;
        } else {
            let is_sch: i64 = m2u_eq(tag, 32481);
            let is_exp: i64 = m2u_eq(tag, 32482);
            let sch_n: i64 = m2u_sel(is_sch, dc_u16(w, pos + 2), 0);
            pos = m2u_sel(is_end, nwords, m2u_sel(is_sch, pos + 3 + sch_n * 2, m2u_sel(is_exp, pos + 5, pos + 1)));
        };
        g1 = (1 - is_end) * m2u_lt(pos, nwords - 1);
    }
    return nfns;
}

// Emits header + all functions into Band A.
#[strict]
fn dc_render_all(arena: bytes, nwords: i64, hash: i64, nfns: i64) -> bytes {
    let w: bytes = iset_patch_i64(arena, 0, 0);
    w = su_out4(su_out4(su_out4(w, 47, 47, 32, 61), 61, 61, 32, 79), 77, 78, 73, 32);
    w = su_out4(su_out4(su_out4(w, 65, 85, 68, 73), 84, 32, 86, 73), 69, 87, 32, 40);
    w = su_out4(su_out4(su_out4(w, 77, 51, 32, 68), 69, 67, 79, 77), 80, 73, 76, 69);
    w = su_out4(su_out4(w, 82, 41, 32, 61), 61, 61, 10, 0);
    w = su_out4(su_out4(su_out4(w, 47, 47, 32, 119), 111, 114, 100, 115), 61, 0, 0, 0);
    w = su_out_i64(w, nwords);
    w = su_out4(su_out4(su_out4(w, 32, 124, 32, 102), 110, 118, 49, 97), 54, 52, 61, 0);
    w = su_out_hex(w, hash, 16);
    w = su_out4(su_out4(su_out4(w, 32, 124, 32, 102), 117, 110, 99, 116), 105, 111, 110, 115);
    w = su_out_u8(su_out_i64(su_out_u8(w, 61), nfns), 10);
    let p2: i64 = 1;
    let idx: i64 = 0;
    let g2: i64 = m2u_lt(p2, nwords - 1);
    while g2 <=> 0 {
        let tag: i64 = dc_u16(w, p2);
        let is_fn: i64 = m2u_eq(tag, 32483);
        let is_end: i64 = m2u_eq(tag, 32495);
        if_pos is_fn <=> 0 {
            w = dc_emit_fn(w, nwords, p2, idx, nfns);
            p2 = ld_u64(w, 88);
            idx = idx + 1;
        } else {
            let is_sch: i64 = m2u_eq(tag, 32481);
            let is_exp: i64 = m2u_eq(tag, 32482);
            let sch_n: i64 = m2u_sel(is_sch, dc_u16(w, p2 + 2), 0);
            p2 = m2u_sel(is_end, nwords, m2u_sel(is_sch, p2 + 3 + sch_n * 2, m2u_sel(is_exp, p2 + 5, p2 + 1)));
        };
        g2 = (1 - is_end) * m2u_lt(p2, nwords - 1);
    }
    return w;
}

#[strict]
#[cap(SYS)]
fn main() -> i64 {
    let w: bytes = su_load_cmdline(su_alloc_arena());
    let argc: i64 = su_argc(w);
    let rc: i64 = if_pos m2u_lt(argc, 2) <=> 0 {
        2
    } else {
        let p_cstr: bytes = su_make_cstr(w, su_arg_off(w, 1), su_arg_len(w, 1));
        let nb: i64 = su_read_file_into(w, p_cstr, dc_in_off(), 256000);
        let nwords: i64 = nb >> 1;
        let ok: i64 = m2u_ge(nb, 4) * m2u_eq(nb & 1, 0) * m2u_eq(dc_u16(w, 0), 32480) * m2u_eq(dc_u16(w, nwords - 1), 32495);
        if_pos ok <=> 0 {
            let nfns: i64 = dc_count_fns(w, nwords);
            if_pos m2u_eq(nfns, 0) <=> 0 {
                1
            } else {
                let hash: i64 = su_fnv1a64(w, dc_in_off(), nb);
                let w2: bytes = dc_render_all(w, nwords, hash, nfns);
                let nw: i64 = sys_write(1, w2, su_band_a(), ld_u64(w2, 0));
                0 + nw * 0
            }
        } else {
            1
        }
    };
    return sys_exit(rc);
}
