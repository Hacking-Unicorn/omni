#[strict]
#[cap(SYS)]
fn dc_render_all(arena: bytes,nwords: i64,shash: i64,nfns: i64) -> i64 {
let w: bytes = iset_patch_i64(iset_patch_i64(iset_patch_i64(arena,56,0),64,0),96,0);
let pos: i64 = 1;
let pos_idx: i64 = 0;
