// ==============================================================================
// pure/m2/elf.omni  (Milestone 2, M2-11) — ELF64 header, prologues, and stubs
// ==============================================================================
// Link order: pure/m2/util.omni, pure/isa/table.omni, pure/m2/decode.omni,
//             pure/m2/labels.omni, pure/m2/arena.omni, this file.
// Emits byte-exact ELF64 headers (176 B, base 0x400000, entry 0x4000B0, PT_LOAD
// p_flags=5 align 0x1000 + PT_GNU_STACK p_flags=6 align 0x10) and x86-64 frame/trap/multi stubs.
// Iterative, zero recursion, zero ANEW, gated by `omni m2-lint` with 0 findings.
// ==============================================================================

// Emits the 176-byte ELF64 header + PT_LOAD + PT_GNU_STACK (non-exec stack) into the output band.
// Byte-identical to omni_rust_bootstrap.rs (compile_pure_u16_to_x86_64_elf_with_args).
#[strict]
fn m2e_emit_elf64_hdr(arena: bytes, total_size: i64) -> bytes {
    let w: bytes = arena;
    // Zero 176 bytes (22 x u64) first so every reserved field is 0.
    let i: i64 = 0;
    while 22 - i <=> 0 {
        w = m2a_emit_u64(w, 0);
        i = i + 1;
    }
    // e_ident[0..4] = 0x7F 'E' 'L' 'F' = 0x464C457F (1179403647)
    w = m2a_patch_u32(w, 0, 1179403647);
    // e_ident[4..8] = [2 (ELFCLASS64), 1 (ELFDATA2LSB), 1 (EV_CURRENT), 0] = 0x00010102 (65794)
    w = m2a_patch_u32(w, 4, 65794);
    // e_type (16..18) = 2 (ET_EXEC), e_machine (18..20) = 0x3E (EM_X86_64) -> 0x003E0002 (4063234)
    w = m2a_patch_u32(w, 16, 4063234);
    // e_version (20..24) = 1
    w = m2a_patch_u32(w, 20, 1);
    // e_entry (24..32) = 0x4000B0 (4194480)
    w = m2a_patch_u64(w, 24, 4194480);
    // e_phoff (32..40) = 64
    w = m2a_patch_u64(w, 32, 64);
    // e_ehsize (52..54) = 64, e_phentsize (54..56) = 56 -> 0x00380040 (3670080)
    w = m2a_patch_u32(w, 52, 3670080);
    // e_phnum (56..58) = 2 (PT_LOAD + PT_GNU_STACK), e_shentsize (58..60) = 0
    w = m2a_patch_u32(w, 56, 2);
    // PT_LOAD program header at offset 64:
    // p_type (64..68) = 1 (PT_LOAD), p_flags (68..72) = 5 (PF_R | PF_X)
    w = m2a_patch_u32(w, 64, 1);
    w = m2a_patch_u32(w, 68, 5);
    // p_vaddr (80..88) = 0x400000 (4194304), p_paddr (88..96) = 0x400000
    w = m2a_patch_u64(w, 80, 4194304);
    w = m2a_patch_u64(w, 88, 4194304);
    // p_filesz (96..104) = total_size, p_memsz (104..112) = total_size
    w = m2a_patch_u64(w, 96, total_size);
    w = m2a_patch_u64(w, 104, total_size);
    // p_align (112..120) = 0x1000 (4096)
    w = m2a_patch_u64(w, 112, 4096);
    // PT_GNU_STACK program header at offset 120 (non-executable stack: PF_R | PF_W):
    // p_type (120..124) = 0x6474E551 (1685382481), p_flags (124..128) = 6 (PF_R | PF_W)
    w = m2a_patch_u32(w, 120, 1685382481);
    w = m2a_patch_u32(w, 124, 6);
    // p_align (168..176) = 16
    w = m2a_patch_u64(w, 168, 16);
    return w;
}

// Updates p_filesz and p_memsz in an already-emitted ELF64 header.
#[strict]
fn m2e_patch_elf64_size(arena: bytes, total_size: i64) -> bytes {
    let w: bytes = m2a_patch_u64(arena, 96, total_size);
    w = m2a_patch_u64(w, 104, total_size);
    return w;
}

// Emits a 12-byte Linux x86-64 exit(exit_code) trap stub (spec/m2/PLAN.md §2.1):
//   BF imm32(exit_code)  B8 3C 00 00 00  0F 05
#[strict]
fn m2e_emit_trap_stub(arena: bytes, exit_code: i64) -> bytes {
    let w: bytes = m2a_emit_u8(arena, 191);      // 0xBF (mov edi, imm32)
    w = m2a_emit_u32(w, exit_code);              // imm32(exit_code)
    w = m2a_emit_u8(w, 184);                     // 0xB8 (mov eax, imm32)
    w = m2a_emit_u32(w, 60);                     // 60 (sys_exit)
    w = m2a_emit_u16(w, 1295);                   // 0x050F -> 0F 05 (syscall)
    return w;
}

// Emits the 11-byte x86-64 function prologue (spec/m2/PLAN.md §2.3):
//   55 48 89 E5  48 81 EC imm32(frame_bytes)
#[strict]
fn m2e_emit_fn_prologue(arena: bytes, frame_bytes: i64) -> bytes {
    // 55 48 = 0x4855 (18517), 89 E5 = 0xE589 (58761)
    let w: bytes = m2a_emit_u16(arena, 18517);
    w = m2a_emit_u16(w, 58761);
    // 48 81 EC = 0xEC8148 (3 bytes: emit u16 0x8148 = 33096, then u8 0xEC = 236)
    w = m2a_emit_u16(w, 33096);
    w = m2a_emit_u8(w, 236);
    w = m2a_emit_u32(w, frame_bytes);
    return w;
}

// Emits the 11-byte single-mode frame prologue (sub rsp, 0x20800 = 133120).
#[strict]
fn m2e_emit_single_frame_prologue(arena: bytes) -> bytes {
    return m2e_emit_fn_prologue(arena, 133120);
}

// Emits the 25-byte multi-mode entry stub head (spec/m2/PLAN.md §2.2):
//   55 48 89 E5 48 81 EC 10 00 11 00   (push rbp; mov rbp,rsp; sub rsp,0x110010)
//   48 89 E3                           (mov rbx, rsp)
//   48 C7 83 00 00 11 00 00 00 00 00   (mov qword [rbx+0x110000], 0)
#[strict]
fn m2e_emit_multi_stub_head(arena: bytes) -> bytes {
    let w: bytes = m2e_emit_fn_prologue(arena, 1114128); // 0x110010
    // 48 89 E3 = mov rbx, rsp
    w = m2a_emit_u16(w, 35144);                  // 0x8948
    w = m2a_emit_u8(w, 227);                     // 0xE3
    // 48 C7 83 00 00 11 00 00 00 00 00
    w = m2a_emit_u16(w, 51016);                  // 0xC748
    w = m2a_emit_u8(w, 131);                     // 0x83
    w = m2a_emit_u32(w, 1114112);                // 0x110000
    w = m2a_emit_u32(w, 0);                      // imm32 0
    return w;
}
