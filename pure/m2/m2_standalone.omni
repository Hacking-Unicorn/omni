// ==============================================================================
// pure/m2/m2_standalone.omni  (Milestone 2, M2-16) — Standalone M2 compiler entry
// ==============================================================================
// Link order: pure/m2/util.omni, pure/isa/table.omni, pure/m2/decode.omni,
//             pure/m2/labels.omni, pure/m2/verify/mod_check.omni,
//             pure/m2/arena.omni, pure/m2/elf.omni, pure/m2/emit_x86.omni,
//             pure/m2/emit_multi.omni, this file.
// 4-parameter standalone entry point for compiling `.omni_bc` into a self-hosted
// native Linux x86-64 ELF64 binary (M2-16 fixed point). Runs `m2_verify_module_into`
// first and traps fail-closed via `ret_slice(w, m2l_out(), -1)` on unverified input.
// ==============================================================================

#[strict]
fn m2_standalone_entry(arr: array, arg0: i64, arg1: i64, arg2: i64) -> bytes {
    let w: bytes = anew(0);
    let i: i64 = 0;
    while 65536 - i <=> 0 {
        w = iset_i64(w, 0);
        i = i + 1;
    }
    w = m2_verify_module_into(w, arr);
    let verr: i64 = ld_u32(w, m2v_state() + 8);
    let ok: i64 = m2u_eq(verr, 0);
    w = if_pos ok <=> 0 {
        m2_compile_multi_x86_into(w, arr, arg0, arg1, arg2)
    } else {
        w
    };
    let n: i64 = m2u_sel(ok, ld_u64(w, m2l_regs()), 0 - 1);
    return ret_slice(w, m2l_out(), n);
}
