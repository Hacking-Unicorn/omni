// ==============================================================================
// pure/m2/emit_x86.omni  (Milestone 2, M2-12) — Pure-Omni x86-64 machine-code emitter
// ==============================================================================
// Link order: pure/m2/util.omni, pure/isa/table.omni, pure/m2/decode.omni,
//             pure/m2/labels.omni, pure/m2/arena.omni, pure/m2/elf.omni, this file.
// Emits x86-64 Linux ELF64 machine code byte-for-byte identical to the Rust
// reference `compile_pure_u16_to_x86_64_elf_with_args` (including the 19,731-word
// Stage-1 self-compiler stream -> 106,242 B, FNV-1a64 0xEAFC81F46B482FF8).
// Iterative, zero recursion, zero ANEW, gated by `omni m2-lint` with 0 findings.
// ==============================================================================

// Helper: emit 3 bytes (b0, b1, b2) compactly.
#[strict]
fn m2x_b3(arena: bytes, b0: i64, b1: i64, b2: i64) -> bytes {
    let w: bytes = m2a_emit_u16(arena, (b0 & 255) | ((b1 & 255) << 8));
    w = m2a_emit_u8(w, b2);
    return w;
}

// Helper: emit 4 bytes (b0, b1, b2, b3) compactly.
#[strict]
fn m2x_b4(arena: bytes, b0: i64, b1: i64, b2: i64, b3: i64) -> bytes {
    let w: bytes = m2a_emit_u16(arena, (b0 & 255) | ((b1 & 255) << 8));
    w = m2a_emit_u16(w, (b2 & 255) | ((b3 & 255) << 8));
    return w;
}

// Emits `mov [rbp - 8*(d_reg + 1)], rax` (48 89 85 disp32) when d_reg >= 0.
#[strict]
fn m2x_store_rax(arena: bytes, d_reg: i64) -> bytes {
    let ok: trit = m2u_ge(d_reg, 0) <=> 0;
    let r: bytes = if_pos ok {
        let disp: i64 = 0 - 8 * (d_reg + 1);
        let w: bytes = m2x_b3(arena, 72, 137, 133); // 48 89 85
        m2a_emit_u32(w, disp)
    } else {
        arena
    };
    return r;
}

// Loads a decoded packed operand (from m2d_operand) into rax (into_rcx=0) or rcx (into_rcx=1).
// Param 0..3 -> 4C 89 (E0 + p*8 + into_rcx); Reg r -> 48 8B (85 + into_rcx*8) disp32;
// Imm / Trit -> 48 (B8 + into_rcx) imm64.
#[strict]
fn m2x_load_op(arena: bytes, packed: i64, into_rcx: i64) -> bytes {
    let kind: i64 = m2d_kind(packed);
    let is_reg: trit = m2u_eq(kind, 1) <=> 0;
    let is_par: trit = m2u_eq(kind, 2) <=> 0;
    let is_trit: trit = m2u_eq(kind, 4) <=> 0;
    let is_imm: trit = m2u_eq(kind, 5) <=> 0;
    let r1: bytes = if_pos is_reg {
        let disp: i64 = 0 - 8 * (m2d_uval(packed) + 1);
        let w: bytes = m2x_b3(arena, 72, 139, 133 + into_rcx * 8);
        m2a_emit_u32(w, disp)
    } else {
        arena
    };
    let r2: bytes = if_pos is_par {
        let p: i64 = m2d_uval(packed);
        let okp: trit = m2u_in(p, 0, 3) <=> 0;
        if_pos okp {
            m2x_b3(r1, 76, 137, 224 + p * 8 + into_rcx)
        } else {
            r1
        }
    } else {
        r1
    };
    let r3: bytes = if_pos is_imm {
        let w: bytes = m2a_emit_u16(r2, 72 | ((184 + into_rcx) << 8));
        m2a_emit_u64(w, m2d_ival(packed))
    } else {
        r2
    };
    let r4: bytes = if_pos is_trit {
        let w: bytes = m2a_emit_u16(r3, 72 | ((184 + into_rcx) << 8));
        m2a_emit_u64(w, m2d_uval(packed) - 1)
    } else {
        r3
    };
    return r4;
}

// Emits the 65-byte x86-64 CLI decimal integer parser (omni_rust_bootstrap.rs:17412).
#[strict]
fn m2x_cli_parser(arena: bytes, argc_min: i64, disp_argv: i64, target_reg_code: i64) -> bytes {
    let w: bytes = m2x_b4(arena, 72, 131, 125, 8);          // 48 83 7D 08
    w = m2x_b3(w, argc_min, 124, 58);                       // argc_min 7C 3A
    w = m2x_b4(w, 72, 139, 117, disp_argv);                 // 48 8B 75 disp_argv
    w = m2x_b3(w, 49, 192, 191);                            // 31 C0 BF
    w = m2a_emit_u32(w, 1);                                 // 01 00 00 00
    w = m2x_b3(w, 15, 182, 14);                             // 0F B6 0E
    w = m2x_b3(w, 128, 249, 45);                            // 80 F9 2D
    w = m2x_b4(w, 117, 10, 72, 199);                        // 75 0A 48 C7
    w = m2a_emit_u8(w, 199);                                // C7
    w = m2a_emit_u32(w, 0 - 1);                             // FF FF FF FF
    w = m2x_b3(w, 72, 255, 198);                            // 48 FF C6
    w = m2x_b3(w, 15, 182, 14);                             // 0F B6 0E
    w = m2x_b4(w, 132, 201, 116, 15);                       // 84 C9 74 0F
    w = m2x_b3(w, 131, 233, 48);                            // 83 E9 30
    w = m2x_b4(w, 72, 107, 192, 10);                        // 48 6B C0 0A
    w = m2x_b3(w, 72, 1, 200);                              // 48 01 C8
    w = m2x_b3(w, 72, 255, 198);                            // 48 FF C6
    w = m2a_emit_u16(w, 60139);                             // EB EA (0xEAEB)
    w = m2x_b4(w, 72, 15, 175, 199);                        // 48 0F AF C7
    w = m2x_b3(w, 73, 137, 192 + target_reg_code);          // 49 89 (C0+reg)
    return w;
}

// Emits the TY_BYTES single-mode prologue body (after 11-byte frame setup).
#[strict]
fn m2x_prologue_bytes(arena: bytes, arg0: i64, arg1: i64, arg2: i64) -> bytes {
    let w: bytes = m2x_b3(arena, 73, 199, 196);             // 49 C7 C4
    w = m2a_emit_u32(w, 0);                                 // 00 00 00 00
    w = m2a_emit_u16(w, 48457);                             // 49 BD (0xBD49)
    w = m2a_emit_u64(w, arg0);
    w = m2a_emit_u16(w, 48713);                             // 49 BE (0xBE49)
    w = m2a_emit_u64(w, arg1);
    w = m2a_emit_u16(w, 48969);                             // 49 BF (0xBF49)
    w = m2a_emit_u64(w, arg2);
    // open/read/close argv[1] into [rbp - 0x2E000] (0xE000 bytes), xor r11d, r11d
    w = m2x_b4(w, 72, 131, 125, 8);                         // 48 83 7D 08
    w = m2x_b3(w, 2, 124, 46);                              // 02 7C 2E
    w = m2x_b4(w, 72, 139, 125, 24);                        // 48 8B 7D 18
    w = m2x_b4(w, 49, 246, 49, 210);                        // 31 F6 31 D2
    w = m2a_emit_u8(w, 184);                                // B8
    w = m2a_emit_u32(w, 2);                                 // 02 00 00 00
    w = m2a_emit_u16(w, 1295);                              // 0F 05
    w = m2x_b3(w, 72, 133, 192);                            // 48 85 C0
    w = m2a_emit_u16(w, 6776);                              // 78 1A (0x1A78)
    w = m2x_b3(w, 72, 137, 199);                            // 48 89 C7
    w = m2x_b3(w, 72, 141, 181);                            // 48 8D B5
    w = m2a_emit_u32(w, 0 - 188416);                        // 00 20 FD FF (-0x2E000)
    w = m2a_emit_u8(w, 186);                                // BA
    w = m2a_emit_u32(w, 57344);                             // 00 E0 00 00 (0xE000)
    w = m2x_b4(w, 49, 192, 15, 5);                          // 31 C0 0F 05
    w = m2a_emit_u8(w, 184);                                // B8
    w = m2a_emit_u32(w, 3);                                 // 03 00 00 00
    w = m2a_emit_u16(w, 1295);                              // 0F 05
    w = m2x_b3(w, 69, 49, 219);                             // 45 31 DB
    w = m2x_cli_parser(w, 3, 32, 5);
    w = m2x_cli_parser(w, 4, 40, 6);
    w = m2x_cli_parser(w, 5, 48, 7);
    return w;
}

// Emits the non-bytes single-mode prologue body (after 11-byte frame setup).
#[strict]
fn m2x_prologue_i64(arena: bytes, arg0: i64, arg1: i64, arg2: i64) -> bytes {
    let w: bytes = m2a_emit_u16(arena, 48201);              // 49 BC (0xBC49)
    w = m2a_emit_u64(w, arg0);
    w = m2a_emit_u16(w, 48457);                             // 49 BD
    w = m2a_emit_u64(w, arg1);
    w = m2a_emit_u16(w, 48713);                             // 49 BE
    w = m2a_emit_u64(w, arg2);
    w = m2x_b3(w, 73, 199, 199);                            // 49 C7 C7
    w = m2a_emit_u32(w, 0);                                 // 00 00 00 00
    w = m2x_cli_parser(w, 2, 24, 4);
    w = m2x_cli_parser(w, 3, 32, 5);
    w = m2x_cli_parser(w, 4, 40, 6);
    w = m2x_cli_parser(w, 5, 48, 7);
    return w;
}

// Emits the full single-mode prologue (11-B frame `sub rsp, 0x30000` + bytes/i64 setup).
#[strict]
fn m2x_single_prologue(arena: bytes, is_bytes: i64, arg0: i64, arg1: i64, arg2: i64) -> bytes {
    let w: bytes = m2e_emit_fn_prologue(arena, 196608);     // 0x30000
    let cb: trit = is_bytes <=> 0;
    let r: bytes = if_pos cb {
        m2x_prologue_bytes(w, arg0, arg1, arg2)
    } else {
        m2x_prologue_i64(w, arg0, arg1, arg2)
    };
    return r;
}

// Emits MOV/cast/ANEW/SLEN (0x7F01..0x7F04, 0x7F06, 0x7F09, 0x7F0D, 0x7F50, 0x7F57..0x7F59).
#[strict]
fn m2x_emit_basic(arena: bytes, op: i64, d: i64, op0: i64) -> bytes {
    let is_mov: trit = (m2u_in(op, 32513, 32516) + m2u_eq(op, 32518) + m2u_eq(op, 32521) + m2u_in(op, 32599, 32601)) <=> 0;
    let is_anew: trit = m2u_eq(op, 32525) <=> 0;
    let is_slen: trit = m2u_eq(op, 32592) <=> 0;
    let r1: bytes = if_pos is_mov {
        let w: bytes = m2x_load_op(arena, op0, 0);
        m2x_store_rax(w, d)
    } else {
        arena
    };
    let r2: bytes = if_pos is_anew {
        let w: bytes = m2x_b3(r1, 69, 49, 219);             // 45 31 DB
        m2x_store_rax(w, d)
    } else {
        r1
    };
    let r3: bytes = if_pos is_slen {
        let w: bytes = m2x_b3(r2, 76, 137, 216);            // 4C 89 D8
        m2x_store_rax(w, d)
    } else {
        r2
    };
    return r3;
}

// Scans one function body and marks provable buffer registers (dest of ANEW 0x7F0D or ISET 0x7F0F)
// in global bitmask slots 1900..1902 (192 bits for r0..r191).
#[strict]
fn m2x_bufreg_scan(arena: bytes, arr: array, n: i64, ins_start: i64, ins_cnt: i64) -> bytes {
    let w: bytes = m2a_g_set(arena, 1900, 0);
    w = m2a_g_set(w, 1901, 0);
    w = m2a_g_set(w, 1902, 0);
    let cur: i64 = ins_start;
    let ii: i64 = 0;
    while ins_cnt - ii <=> 0 {
        let has_d: i64 = m2d_ins_has_dest(arr, n, cur);
        let d: i64 = m2d_ins_dest(arr, n, cur);
        let op: i64 = m2d_ins_op(arr, n, cur);
        let is_buf: i64 = has_d * m2u_in(d, 0, 191) * (m2u_eq(op, 32525) + m2u_eq(op, 32527));
        let rd: i64 = m2u_sel(is_buf, d, 0);
        let slot: i64 = 1900 + (rd >> 6);
        let bit: i64 = 1 << (rd & 63);
        let oldv: i64 = ld_u64(w, m2l_regs() + (slot << 3));
        w = m2a_g_set(w, slot, m2u_sel(is_buf, oldv | bit, oldv));
        let nxt: i64 = m2d_decode_at(arr, n, cur);
        cur = m2u_sel(m2d_is_err(nxt), n, nxt);
        ii = ii + 1;
    }
    return w;
}

// Emits 2-op IGET (0x7F0E): guarded ISET-heap byte readback when op0 is a provable ANEW/ISET buffer
// register (matching Rust AOT x86_buffer_regs), else legacy token-region u16 read.
#[strict]
fn m2x_emit_iget(arena: bytes, op0: i64, op1: i64, d: i64) -> bytes {
    let is_reg: i64 = m2u_eq(m2d_kind(op0), 1);
    let ridx: i64 = m2u_sel(is_reg, m2d_uval(op0), 0);
    let in_r: i64 = is_reg * m2u_in(ridx, 0, 191);
    let bword: i64 = ld_u64(arena, m2l_regs() + ((1900 + (ridx >> 6)) << 3));
    let is_buf: trit = (in_r * ((bword >> (ridx & 63)) & 1)) <=> 0;
    let r: bytes = if_pos is_buf {
        let w: bytes = m2x_load_op(arena, op0, 0);
        w = m2x_load_op(w, op1, 1);
        w = m2x_b4(w, 72, 57, 193, 115);                    // 48 39 C1 73 (cmp rcx, rax; jae)
        w = m2x_b4(w, 15, 76, 57, 217);                     // 0F 4C 39 D9 (+15; cmp rcx, r11)
        w = m2x_b4(w, 115, 10, 15, 182);                    // 73 0A 0F B6 (jae +10; movzx ...)
        w = m2a_emit_u16(w, 3460);                          // 84 0D (0x0D84)
        w = m2a_emit_u32(w, 0 - 131072);                    // 00 00 FE FF (-0x20000)
        w = m2x_b4(w, 235, 2, 49, 192);                     // EB 02 31 C0 (jmp +2; xor eax, eax)
        m2x_store_rax(w, d)
    } else {
        let w: bytes = m2x_load_op(arena, op1, 0);
        w = m2x_b4(w, 15, 183, 132, 69);                    // 0F B7 84 45
        w = m2a_emit_u32(w, 0 - 188416);                    // 00 20 FD FF (-0x2E000)
        m2x_store_rax(w, d)
    };
    return r;
}

// Stores r11 into dest register `d` if d >= 0 (keeps m2x_emit_iset <= 12 labels).
#[strict]
fn m2x_store_r11_opt(arena: bytes, d: i64) -> bytes {
    let ok: trit = m2u_ge(d, 0) <=> 0;
    let r: bytes = if_pos ok {
        let t: bytes = m2x_b3(arena, 76, 137, 216);         // 4C 89 D8
        m2x_store_rax(t, d)
    } else {
        arena
    };
    return r;
}

// Emits ISET (0x7F0F): -4 (append u32), -8 (append u64), -9 (patch u64), or N-byte append.
#[strict]
fn m2x_emit_iset(arena: bytes, arr: array, n: i64, ops_start: i64, nops: i64, d: i64) -> bytes {
    let p0: i64 = m2d_operand(arr, n, ops_start);
    let pos1: i64 = m2d_next(p0);
    let p1: i64 = m2d_operand(arr, n, pos1);
    let pos2: i64 = m2d_next(p1);
    let p2: i64 = m2d_operand(arr, n, pos2);
    let pos3: i64 = m2d_next(p2);
    let p3: i64 = m2d_operand(arr, n, pos3);
    let m_imm: i64 = m2u_eq(m2d_kind(p1), 5);
    let mv: i64 = m2d_ival(p1);
    let is_m4: i64 = m2u_eq(nops, 3) * m_imm * m2u_eq(mv, 0 - 4);
    let is_m8: i64 = m2u_eq(nops, 3) * m_imm * m2u_eq(mv, 0 - 8);
    let is_m9: i64 = m2u_eq(nops, 4) * m_imm * m2u_eq(mv, 0 - 9);
    let is_bytes: i64 = 1 - is_m4 - is_m8 - is_m9;
    let c4: trit = is_m4 <=> 0;
    let c8: trit = is_m8 <=> 0;
    let c9: trit = is_m9 <=> 0;
    let cb: trit = is_bytes <=> 0;
    let w1: bytes = if_pos c4 {
        let t: bytes = m2x_load_op(arena, p2, 0);
        t = m2x_b4(t, 66, 137, 132, 29);                    // 42 89 84 1D
        t = m2a_emit_u32(t, 0 - 131072);                    // 00 00 FE FF (-0x20000)
        m2x_b4(t, 73, 131, 195, 4)                          // 49 83 C3 04
    } else {
        arena
    };
    let w2: bytes = if_pos c8 {
        let t: bytes = m2x_load_op(w1, p2, 0);
        t = m2x_b4(t, 74, 137, 132, 29);                    // 4A 89 84 1D
        t = m2a_emit_u32(t, 0 - 131072);
        m2x_b4(t, 73, 131, 195, 8)                          // 49 83 C3 08
    } else {
        w1
    };
    let w3: bytes = if_pos c9 {
        let t: bytes = m2x_load_op(w2, p2, 1);
        t = m2x_load_op(t, p3, 0);
        t = m2x_b4(t, 72, 137, 132, 13);                    // 48 89 84 0D
        m2a_emit_u32(t, 0 - 131072)
    } else {
        w2
    };
    let w4: bytes = if_pos cb {
        let t: bytes = w3;
        let cur: i64 = pos1;
        let k: i64 = 1;
        while nops - k <=> 0 {
            let pk: i64 = m2d_operand(arr, n, cur);
            t = m2x_load_op(t, pk, 0);
            t = m2x_b4(t, 66, 136, 132, 29);                // 42 88 84 1D
            t = m2a_emit_u32(t, 0 - 131072);
            t = m2x_b3(t, 73, 255, 195);                    // 49 FF C3
            cur = m2d_next(pk);
            k = k + 1;
        }
        t
    } else {
        w3
    };
    return m2x_store_r11_opt(w4, d);
}

// Emits IADD/ISUB/IMUL (0x7F10..0x7F12).
#[strict]
fn m2x_emit_alu_arith(arena: bytes, op: i64, d: i64, op0: i64, op1: i64) -> bytes {
    let w: bytes = m2x_load_op(arena, op0, 0);
    w = m2x_load_op(w, op1, 1);
    let c_add: trit = m2u_eq(op, 32528) <=> 0;              // 0x7F10
    let c_sub: trit = m2u_eq(op, 32529) <=> 0;              // 0x7F11
    let c_mul: trit = m2u_eq(op, 32530) <=> 0;              // 0x7F12
    let r1: bytes = if_pos c_add { m2x_b3(w, 72, 1, 200) } else { w };
    let r2: bytes = if_pos c_sub { m2x_b3(r1, 72, 41, 200) } else { r1 };
    let r3: bytes = if_pos c_mul { m2x_b4(r2, 72, 15, 175, 193) } else { r2 };
    return m2x_store_rax(r3, d);
}

// Emits IAND/IOR/IXOR/ISHL/ISHR (0x7F1E..0x7F20, 0x7F22..0x7F23).
#[strict]
fn m2x_emit_alu_bit(arena: bytes, op: i64, d: i64, op0: i64, op1: i64) -> bytes {
    let w: bytes = m2x_load_op(arena, op0, 0);
    w = m2x_load_op(w, op1, 1);
    let c_and: trit = m2u_eq(op, 32542) <=> 0;              // 0x7F1E
    let c_or: trit = m2u_eq(op, 32543) <=> 0;               // 0x7F1F
    let c_xor: trit = m2u_eq(op, 32544) <=> 0;              // 0x7F20
    let c_sh: trit = m2u_in(op, 32546, 32547) <=> 0;        // 0x7F22/23
    let r1: bytes = if_pos c_and { m2x_b3(w, 72, 33, 200) } else { w };
    let r2: bytes = if_pos c_or { m2x_b3(r1, 72, 9, 200) } else { r1 };
    let r3: bytes = if_pos c_xor { m2x_b3(r2, 72, 49, 200) } else { r2 };
    let r4: bytes = if_pos c_sh {
        let modrm: i64 = m2u_sel(m2u_eq(op, 32546), 224, 248);
        m2x_b3(r3, 72, 211, modrm)
    } else {
        r3
    };
    return m2x_store_rax(r4, d);
}

// Emits IEQ/INEQ/ILT/IGT (0x7F24..0x7F27) and TCMP (0x7F2D).
#[strict]
fn m2x_emit_cmp(arena: bytes, op: i64, d: i64, op0: i64, op1: i64) -> bytes {
    let w: bytes = m2x_load_op(arena, op0, 0);
    w = m2x_load_op(w, op1, 1);
    let c_cmp: trit = m2u_in(op, 32548, 32551) <=> 0;       // 0x7F24..27
    let c_tcmp: trit = m2u_eq(op, 32557) <=> 0;             // 0x7F2D
    let r1: bytes = if_pos c_cmp {
        let setcc: i64 = m2u_eq(op, 32548) * 148 + m2u_eq(op, 32549) * 149 + m2u_eq(op, 32550) * 156 + m2u_eq(op, 32551) * 159;
        let t: bytes = m2x_b3(w, 72, 57, 200);              // 48 39 C8
        t = m2x_b3(t, 15, setcc, 192);                      // 0F setcc C0
        t = m2x_b3(t, 15, 182, 192);                        // 0F B6 C0
        t = m2x_b4(t, 72, 141, 68, 0);                      // 48 8D 44 00
        m2a_emit_u8(t, 255)                                 // FF
    } else {
        w
    };
    let r2: bytes = if_pos c_tcmp {
        let t: bytes = m2x_b3(r1, 72, 57, 200);
        t = m2x_b3(t, 15, 159, 194);                        // 0F 9F C2
        t = m2x_b3(t, 15, 156, 193);                        // 0F 9C C1
        t = m2x_b3(t, 15, 182, 210);                        // 0F B6 D2
        t = m2x_b3(t, 15, 182, 201);                        // 0F B6 C9
        t = m2a_emit_u16(t, 51753);                         // 29 CA (0xCA29)
        m2x_b3(t, 72, 99, 194)                              // 48 63 C2
    } else {
        r1
    };
    return m2x_store_rax(r2, d);
}

// Clamps rax to [-1, 1] via (rax > 0) - (rax < 0) (19 bytes).
#[strict]
fn m2x_clamp_rax(arena: bytes) -> bytes {
    let t: bytes = m2x_b4(arena, 72, 131, 248, 0);          // 48 83 F8 00
    t = m2x_b3(t, 15, 159, 192);                            // 0F 9F C0
    t = m2x_b3(t, 15, 156, 194);                            // 0F 9C C2
    t = m2x_b3(t, 15, 182, 192);                            // 0F B6 C0
    t = m2x_b3(t, 15, 182, 210);                            // 0F B6 D2
    return m2x_b3(t, 72, 41, 208);                          // 48 29 D0
}

// Clamps rcx to [-1, 1] via (rcx > 0) - (rcx < 0) (19 bytes).
#[strict]
fn m2x_clamp_rcx(arena: bytes) -> bytes {
    let t: bytes = m2x_b4(arena, 72, 131, 249, 0);          // 48 83 F9 00
    t = m2x_b3(t, 15, 159, 193);                            // 0F 9F C1
    t = m2x_b3(t, 15, 156, 194);                            // 0F 9C C2
    t = m2x_b3(t, 15, 182, 201);                            // 0F B6 C9
    t = m2x_b3(t, 15, 182, 210);                            // 0F B6 D2
    return m2x_b3(t, 72, 41, 209);                          // 48 29 D1
}

// Emits IMIN/TAND (0x7F17/0x7F29), IMAX/TOR (0x7F18/0x7F2A), TXOR (0x7F2B).
#[strict]
fn m2x_emit_minmax_txor(arena: bytes, op: i64, d: i64, op0: i64, op1: i64) -> bytes {
    let is_trit: trit = m2u_in(op, 32553, 32555) <=> 0;     // 7F29..7F2B
    let w0: bytes = m2x_load_op(arena, op0, 0);
    let w1: bytes = m2x_load_op(w0, op1, 1);
    let w: bytes = if_pos is_trit {
        let tc: bytes = m2x_clamp_rax(w1);
        m2x_clamp_rcx(tc)
    } else {
        w1
    };
    let c_min: trit = (m2u_eq(op, 32535) + m2u_eq(op, 32553)) <=> 0;
    let c_max: trit = (m2u_eq(op, 32536) + m2u_eq(op, 32554)) <=> 0;
    let c_txor: trit = m2u_eq(op, 32555) <=> 0;
    let r1: bytes = if_pos c_min {
        let t: bytes = m2x_b3(w, 72, 57, 200);
        m2x_b4(t, 72, 15, 79, 193)                          // 48 0F 4F C1
    } else {
        w
    };
    let r2: bytes = if_pos c_max {
        let t: bytes = m2x_b3(r1, 72, 57, 200);
        m2x_b4(t, 72, 15, 76, 193)                          // 48 0F 4C C1
    } else {
        r1
    };
    let r3: bytes = if_pos c_txor {
        let t: bytes = m2x_b4(r2, 72, 15, 175, 193);
        m2x_b3(t, 72, 247, 216)                             // 48 F7 D8
    } else {
        r2
    };
    return m2x_store_rax(r3, d);
}

// Emits IDIV/IMOD (0x7F13/0x7F14) into `arena` (keeps m2x_emit_alu_misc <= 12 labels).
#[strict]
fn m2x_emit_divmod(arena: bytes, op: i64, d: i64, op0: i64, op1: i64) -> bytes {
    let is_mod: i64 = m2u_eq(op, 32532);
    let jz_off: i64 = m2u_sel(is_mod, 33, 30);              // 0x21 for IMOD, 0x1E for IDIV
    let t: bytes = m2x_load_op(arena, op0, 0);
    t = m2x_load_op(t, op1, 1);
    t = m2x_b3(t, 73, 137, 192);                            // 49 89 C0
    t = m2x_b4(t, 72, 133, 201, 116);                       // 48 85 C9 74
    t = m2x_b4(t, jz_off, 72, 131, 249);                    // 1E/21 48 83 F9
    t = m2x_b3(t, 255, 117, 17);                            // FF 75 11
    t = m2a_emit_u16(t, 47433);                             // 49 B9
    t = m2a_emit_u32(t, 0);                                 // 00 00 00 00
    t = m2x_b4(t, 0, 0, 0, 128);                            // 00 00 00 80
    t = m2x_b4(t, 77, 57, 200, 117);                        // 4D 39 C8 75
    t = m2x_b3(t, 2, 235, 10);                              // 02 EB 0A
    t = m2x_b4(t, 72, 153, 72, 247);                        // 48 99 48 F7
    t = m2a_emit_u8(t, 249);                                // F9
    let t_m: bytes = if_pos is_mod <=> 0 { m2x_b3(t, 72, 137, 208) } else { t };
    t_m = m2x_b4(t_m, 235, 3, 72, 49);                      // EB 03 48 31
    t_m = m2a_emit_u8(t_m, 192);                            // C0
    return m2x_store_rax(t_m, d);
}

// Emits IDIV/IMOD (0x7F13/0x7F14), INEG/TNOT, IABS, INOT, TMAJ, EGATE.
#[strict]
fn m2x_emit_alu_misc(arena: bytes, op: i64, d: i64, op0: i64, op1: i64, op2: i64) -> bytes {
    let c_div: trit = m2u_in(op, 32531, 32532) <=> 0;       // 7F13/14
    let c_neg: trit = (m2u_eq(op, 32533) + m2u_eq(op, 32552)) <=> 0; // 7F15/7F28
    let c_abs: trit = m2u_eq(op, 32534) <=> 0;              // 7F16
    let c_not: trit = m2u_eq(op, 32545) <=> 0;              // 7F21
    let c_maj: trit = m2u_eq(op, 32556) <=> 0;              // 7F2C
    let r1: bytes = if_pos c_div {
        m2x_emit_divmod(arena, op, d, op0, op1)
    } else {
        arena
    };
    let r2: bytes = if_pos c_neg {
        let t0: bytes = m2x_load_op(r1, op0, 0);
        let t: bytes = if_pos m2u_eq(op, 32552) <=> 0 { m2x_clamp_rax(t0) } else { t0 };
        t = m2x_b3(t, 72, 247, 216);                        // 48 F7 D8
        m2x_store_rax(t, d)
    } else {
        r1
    };
    let r3: bytes = if_pos c_abs {
        let t: bytes = m2x_load_op(r2, op0, 0);
        t = m2x_b3(t, 72, 137, 194);                        // 48 89 C2
        t = m2x_b3(t, 72, 247, 216);                        // 48 F7 D8
        t = m2x_b4(t, 72, 15, 72, 194);                     // 48 0F 48 C2
        m2x_store_rax(t, d)
    } else {
        r2
    };
    let r4: bytes = if_pos c_not {
        let t: bytes = m2x_load_op(r3, op0, 0);
        t = m2x_b3(t, 72, 247, 208);                        // 48 F7 D0
        m2x_store_rax(t, d)
    } else {
        r3
    };
    let r5: bytes = if_pos c_maj {
        let t: bytes = m2x_load_op(r4, op0, 0);
        t = m2x_load_op(t, op1, 1);
        t = m2x_clamp_rax(t);
        t = m2x_clamp_rcx(t);
        t = m2x_b3(t, 72, 1, 200);                          // 48 01 C8
        t = m2x_load_op(t, op2, 1);
        t = m2x_clamp_rcx(t);
        t = m2x_b3(t, 72, 1, 200);
        t = m2x_clamp_rax(t);
        m2x_store_rax(t, d)
    } else {
        r4
    };
    return r5;
}

// Emits a rel32 branch displacement for label `packed_lbl` (0 in pass 1, target-(cur+4) in pass 2).
#[strict]
fn m2x_emit_rel32(arena: bytes, packed_lbl: i64, pass: i64) -> bytes {
    let p2: trit = m2u_eq(pass, 2) <=> 0;
    let r: bytes = if_pos p2 {
        let slot: i64 = m2lbl_slot_of(packed_lbl);
        let tgt: i64 = m2lbl_lookup(arena, slot);
        let cur_code_off: i64 = ld_u64(arena, m2l_regs()) - 176;
        let rel: i64 = tgt - (cur_code_off + 4);
        m2a_emit_u32(arena, rel)
    } else {
        m2a_emit_u32(arena, 0)
    };
    return r;
}

// Emits SEL_TRIT (0x7F45) and 1-op RET (0x7F4A).
#[strict]
fn m2x_emit_sel_ret(arena: bytes, op: i64, d: i64, op0: i64, op1: i64, op2: i64, op3: i64, is_bytes: i64) -> bytes {
    let c_sel: trit = m2u_eq(op, 32581) <=> 0;              // 0x7F45
    let c_ret: trit = m2u_eq(op, 32586) <=> 0;              // 0x7F4A
    let r1: bytes = if_pos c_sel {
        let t: bytes = m2x_load_op(arena, op0, 0);
        t = m2x_load_op(t, op1, 1);
        t = m2x_b3(t, 73, 137, 192);                        // 49 89 C0
        t = m2x_b3(t, 72, 137, 202);                        // 48 89 CA
        t = m2x_load_op(t, op2, 1);
        t = m2x_b4(t, 73, 131, 248, 0);                     // 49 83 F8 00
        t = m2x_b4(t, 72, 15, 68, 209);                     // 48 0F 44 D1
        t = m2x_load_op(t, op3, 1);
        t = m2x_b4(t, 73, 131, 248, 0);                     // 49 83 F8 00
        t = m2x_b4(t, 72, 15, 79, 209);                     // 48 0F 4F D1
        t = m2x_b3(t, 72, 137, 208);                        // 48 89 D0
        m2x_store_rax(t, d)
    } else {
        arena
    };
    let r2: bytes = if_pos c_ret {
        let cb: trit = is_bytes <=> 0;
        if_pos cb {
            let t: bytes = m2a_emit_u8(r1, 191);            // BF
            t = m2a_emit_u32(t, 1);                         // 01 00 00 00
            t = m2x_b3(t, 72, 141, 181);                    // 48 8D B5
            t = m2a_emit_u32(t, 0 - 131072);                // 00 00 FE FF
            t = m2x_b3(t, 76, 137, 218);                    // 4C 89 DA
            t = m2a_emit_u8(t, 184);                        // B8
            t = m2a_emit_u32(t, 1);                         // 01 00 00 00
            t = m2a_emit_u16(t, 1295);                      // 0F 05
            t = m2x_b3(t, 49, 255, 184);                    // 31 FF B8
            t = m2a_emit_u32(t, 60);                        // 3C 00 00 00
            m2a_emit_u16(t, 1295)                           // 0F 05
        } else {
            let t: bytes = m2x_load_op(r1, op0, 0);
            t = m2x_b4(t, 72, 131, 236, 8);                 // 48 83 EC 08
            t = m2x_b4(t, 72, 137, 4, 36);                  // 48 89 04 24
            t = m2a_emit_u8(t, 184);                        // B8
            t = m2a_emit_u32(t, 1);                         // 01 00 00 00
            t = m2a_emit_u8(t, 191);                        // BF
            t = m2a_emit_u32(t, 1);                         // 01 00 00 00
            t = m2x_b4(t, 72, 137, 230, 186);               // 48 89 E6 BA
            t = m2a_emit_u32(t, 8);                         // 08 00 00 00
            t = m2a_emit_u16(t, 1295);                      // 0F 05
            t = m2x_b4(t, 72, 131, 196, 8);                 // 48 83 C4 08
            t = m2x_b3(t, 49, 255, 184);                    // 31 FF B8
            t = m2a_emit_u32(t, 60);                        // 3C 00 00 00
            m2a_emit_u16(t, 1295)                           // 0F 05
        }
    } else {
        r1
    };
    return r2;
}

// Emits LABEL (0x7F40), JMP (0x7F41), BR_TRIT (0x7F42), BR_POS/BR_NEG (0x7F43/0x7F44).
#[strict]
fn m2x_emit_branch(arena: bytes, op: i64, op0: i64, op1: i64, op2: i64, op3: i64, pass: i64) -> bytes {
    let c_lbl: trit = (m2u_eq(op, 32576) * m2u_eq(pass, 1)) <=> 0;
    let c_jmp: trit = m2u_eq(op, 32577) <=> 0;
    let c_brt: trit = m2u_eq(op, 32578) <=> 0;
    let c_brpn: trit = m2u_in(op, 32579, 32580) <=> 0;
    let r1: bytes = if_pos c_lbl {
        let slot: i64 = m2lbl_slot_of(op0);
        let code_off: i64 = ld_u64(arena, m2l_regs()) - 176;
        m2lbl_define(arena, slot, code_off)
    } else {
        arena
    };
    let r2: bytes = if_pos c_jmp {
        let t: bytes = m2a_emit_u8(r1, 233);                // E9
        m2x_emit_rel32(t, op0, pass)
    } else {
        r1
    };
    let r3: bytes = if_pos c_brt {
        let t: bytes = m2x_load_op(r2, op0, 0);
        t = m2x_b4(t, 72, 131, 248, 0);                     // 48 83 F8 00
        t = m2a_emit_u16(t, 35855);                         // 0F 8C (0x8C0F)
        t = m2x_emit_rel32(t, op1, pass);
        t = m2a_emit_u16(t, 33807);                         // 0F 84 (0x840F)
        t = m2x_emit_rel32(t, op2, pass);
        t = m2a_emit_u8(t, 233);                            // E9
        m2x_emit_rel32(t, op3, pass)
    } else {
        r2
    };
    let r4: bytes = if_pos c_brpn {
        let t: bytes = m2x_load_op(r3, op0, 0);
        let jcc: i64 = m2u_sel(m2u_eq(op, 32579), 36623, 35855); // 0F 8F (jg) / 0F 8C (jl)
        t = m2x_b4(t, 72, 131, 248, 0);                     // 48 83 F8 00
        t = m2a_emit_u16(t, jcc);                           // 0F 8F / 0F 8C
        m2x_emit_rel32(t, op1, pass)
    } else {
        r3
    };
    return r4;
}
