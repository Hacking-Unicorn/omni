// ==============================================================================
// pure/m3/m3_standalone.omni  (Audit §3.1) — Standalone native M3 compiler entry
// ==============================================================================
// 4-parameter standalone entry point for compiling `pure/m3/*` into a native
// Linux x86-64 ELF64 binary (`m3.elf <src_u16_file> [strict_0_or_1]`).
// Allocates the 768 KiB M3 arena in M2's 1 MiB rbx arena, runs `m3_compile_all_into`,
// and returns the exact `.omni_bc` byte stream (or 16-B error sentinel) via ret_slice.
// ==============================================================================

include "pure/m3/lower.omni";

#[strict]
fn m3_standalone_entry(src: array, strict_arg: i64, a1: i64, a2: i64) -> bytes {
    let w: bytes = anew(0);
    let i: i64 = 0;
    while 98304 - i <=> 0 {
        w = iset_i64(w, 0);
        i = i + 1;
    }
    w = m3_compile_all_into(w, src, strict_arg);
    let sbase: i64 = ld_u64(w, 232);
    let err: i64 = ld_u64(w, 40);
    let nbytes: i64 = m2u_sel(m2u_lt(0, err), 16, ld_u64(w, 240) << 1);
    return ret_slice(w, sbase, nbytes);
}
