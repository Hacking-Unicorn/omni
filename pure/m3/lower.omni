// ==============================================================================
// pure/m3/lower.omni  (Milestone 3, M3-10) — Iterative work-stack lowering & pack
// ==============================================================================
// Iterative, zero recursion, zero ANEW, every fn <= 12 labels / <= 120 SSA.
// Lowers Pass P ASTs into exact u16 `.omni_bc` bytecode streams matching Rust
// `compile_omni_surface_to_u16` word-for-word (0-word diff):
//   - per-fn symbol table (`0x07000..0x07DFF`), C4 label allocator (1..15, 0)
//   - 192-reg SSA allocator, unresolved-label checker
//   - work-stack lowering for Int, Trit, Var, UnOp, BinOp (15 ops), Call (user
//     fns + core intrinsics), Let, Assign, While, DoWhile, Label, Goto, Ret
//     (1-op & 3-op ret_slice), ExprStmt
//   - single-fn and multi-fn module packer (`TOK_MOD_BEGIN`..`TOK_MOD_END`).
// ==============================================================================

include "pure/m3/stmt.omni";
include "pure/m3/inc/lower_body.omni";

// Top-level Pure-Omni `.omni` -> `.omni_bc` u16 stream compiler (Pass L + Pass S + Pass P + Pass B).
#[strict]
fn m3_compile_all(arena: bytes, src: array, strict_arg: i64) -> bytes {
    let w2: bytes = m3_compile_all_into(arena, src, strict_arg);
    let sbase: i64 = ld_u64(w2, 232);
    let err: i64 = ld_u64(w2, 40);
    let nbytes: i64 = m2u_sel(m2u_lt(0, err), 16, ld_u64(w2, 240) << 1);
    return ret_slice(w2, sbase, nbytes);
}
