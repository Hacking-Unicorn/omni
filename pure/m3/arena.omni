// ==============================================================================
// pure/m3/arena.omni  (Milestone 3, M3-05) — M3 arena layout, globals, & emitter
// ==============================================================================
// Link order: pure/m2/util.omni, this file.
// Implements spec/m3/PLAN.md §3 layout (physical = logical - 0x80000):
//   0x00000..0x007FF  globals (256 x i64)
//   0x0E000..0x0E0FF  token ring (4 x 16 B)
//   0x10000..0x17FFF  ident/string pool (32 KiB)
//   0x18000..0x1BFFF  per-fn AST node pool (1024 x 16 B)
//   0x20000..         output buffer (tokens / AST / u16 stream)
// Iterative, zero recursion, zero ANEW, gated by `omni m2-lint` with 0 findings.
// ==============================================================================

#[strict]
fn m3l_band() -> i64 { return 524288; }          // 0x80000
#[strict]
fn m3l_globals() -> i64 { return 0; }            // 0x00000
#[strict]
fn m3l_fntab() -> i64 { return 32768; }          // 0x08000 (512 fns x 32 B)
#[strict]
fn m3l_mactab() -> i64 { return 49152; }         // 0x0C000 (128 macros x 64 B)
#[strict]
fn m3l_ring() -> i64 { return 57344; }           // 0x0E000
#[strict]
fn m3l_pool() -> i64 { return 65536; }           // 0x10000
#[strict]
fn m3l_ast() -> i64 { return 98304; }            // 0x18000
#[strict]
fn m3l_out() -> i64 { return 131072; }           // 0x20000

// Global slot indices (0..255).
#[strict]
fn m3g_pos() -> i64 { return 0; }
#[strict]
fn m3g_src_len() -> i64 { return 1; }
#[strict]
fn m3g_line() -> i64 { return 2; }
#[strict]
fn m3g_col() -> i64 { return 3; }
#[strict]
fn m3g_strict() -> i64 { return 4; }
#[strict]
fn m3g_err_code() -> i64 { return 5; }
#[strict]
fn m3g_err_line() -> i64 { return 6; }
#[strict]
fn m3g_err_col() -> i64 { return 7; }
#[strict]
fn m3g_tok_cnt() -> i64 { return 8; }
#[strict]
fn m3g_out_len() -> i64 { return 9; }
#[strict]
fn m3g_pool_top() -> i64 { return 10; }
#[strict]
fn m3g_ast_top() -> i64 { return 11; }

// Error codes (matching Rust error classes).
#[strict]
fn m3err_ok() -> i64 { return 0; }
#[strict]
fn m3err_syntax() -> i64 { return 1; }
#[strict]
fn m3err_ambiguous() -> i64 { return 2; }
#[strict]
fn m3err_budget() -> i64 { return 3; }
#[strict]
fn m3err_bad_type() -> i64 { return 4; }
#[strict]
fn m3err_missing_cap() -> i64 { return 5; }

#[strict]
fn m3a_g_get(arena: bytes, slot: i64) -> i64 {
    return ld_u64(arena, slot << 3);
}

#[strict]
fn m3a_g_set(arena: bytes, slot: i64, val: i64) -> bytes {
    return iset_patch_i64(arena, slot << 3, val);
}

#[strict]
fn m3a_set_err(arena: bytes, code: i64, line: i64, col: i64) -> bytes {
    let w: bytes = iset_patch_i64(arena, 40, code);
    w = iset_patch_i64(w, 48, line);
    w = iset_patch_i64(w, 56, col);
    return w;
}

// Initializes M3 globals (slots 0..23) for a source buffer of length `src_len`.
#[strict]
fn m3a_init(arena: bytes, src_len: i64, strict: i64) -> bytes {
    let w: bytes = arena;
    let i: i64 = 0;
    while 24 - i <=> 0 {
        w = iset_patch_i64(w, i << 3, 0);
        i = i + 1;
    }
    w = iset_patch_i64(w, 8, src_len);           // m3g_src_len
    w = iset_patch_i64(w, 16, 1);                // m3g_line = 1
    w = iset_patch_i64(w, 24, 1);                // m3g_col = 1
    w = iset_patch_i64(w, 32, strict);           // m3g_strict
    return w;
}

// Appends one 16-byte token record `{kind u16, sub u16, line u16, col u16, val i64}` to m3l_out().
#[strict]
fn m3a_emit_tok(arena: bytes, kind: i64, sub: i64, line: i64, col: i64, val: i64) -> bytes {
    let olen: i64 = ld_u64(arena, 72);           // m3g_out_len
    let cap: i64 = slen(arena) - m3l_out() - 16;
    let cmp: trit = cap <=> olen;
    let ok: trit = sel_trit(cmp, 0, 1, 1) <=> 0;
    let r: bytes = if_pos ok {
        let base: i64 = m3l_out() + olen;
        let hdr: i64 = (kind & 65535) | ((sub & 65535) << 16) | ((line & 65535) << 32) | ((col & 65535) << 48);
        let w: bytes = iset_patch_i64(arena, base, hdr);
        w = iset_patch_i64(w, base + 8, val);
        w = iset_patch_i64(w, 72, olen + 16);
        let cnt: i64 = ld_u64(w, 64);
        iset_patch_i64(w, 64, cnt + 1)
    } else {
        m3a_set_err(arena, m3err_budget(), line, col)
    };
    return r;
}

// Returns the emitted output slice via M2-06 `ret_slice`.
// On error, overwrites output[0..16] with sentinel `{0xFFFF, err_code, err_line, err_col, 0}`.
#[strict]
fn m3a_finish_lex(arena: bytes) -> bytes {
    let err: i64 = ld_u64(arena, 40);
    let has_err: trit = err <=> 0;
    let w: bytes = if_pos has_err {
        let el: i64 = ld_u64(arena, 48);
        let ec: i64 = ld_u64(arena, 56);
        let hdr: i64 = 65535 | ((err & 65535) << 16) | ((el & 65535) << 32) | ((ec & 65535) << 48);
        let u: bytes = iset_patch_i64(arena, m3l_out(), hdr);
        u = iset_patch_i64(u, m3l_out() + 8, 0);
        iset_patch_i64(u, 72, 16)
    } else {
        arena
    };
    let n: i64 = ld_u64(w, 72);
    return ret_slice(w, m3l_out(), n);
}
