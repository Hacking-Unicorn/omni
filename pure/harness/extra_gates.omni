// ==============================================================================
// pure/harness/extra_gates.omni (Step 8b) — Pure-Omni PORT-NOW Harness Gates
// ==============================================================================
// Ports the 5 PORT-NOW suites identified in `spec/harness-accounting.md` (29 checks)
// with FULL-TEXT BYTE-IDENTICAL output vs Rust `./omni <gate>`:
//   - m3-modular          (13 checks): mod_parse (42265w) + m3_standalone (26223w) +
//                                      elf_link (3582w) < 65536w + link-elf -> 206,946 B m3.elf
//   - a3-macro-quarantine ( 4 checks): macro rejected fail-closed + weighted_diff_pure_golden -> 100
//   - b4-pure-launcher    ( 5 checks): pure/m5/launcher.omni zero-shim 237 B ELF64 verified
//   - p5-sys              ( 3 checks): pure/m5/elf_sys.omni zero-shim 233 B ELF64 verified
//   - s5-refreeze         ( 4 checks): PT_GNU_STACK non-exec (p_flags==6) on m2/m3/m4/verifier ELFs
//                                      + frozen seed hashes intact
// ==============================================================================

include "../m2/util.omni";
include "../driver/sys_util.omni";

// Builds `<dir_of_argv0>/<tool>\0` where tid: 0=m3.elf, 1=m2.elf, 2=verifier.elf, 3=m4.elf, 4=omnic_pure.elf
#[strict]
fn eg_tool(arena: bytes, tid: i64) -> bytes {
    let a0_off: i64 = su_arg_off(arena, 0);
    let a0_len: i64 = su_arg_len(arena, 0);
    let slash: i64 = 0 - 1;
    let i: i64 = 0;
    while a0_len - i <=> 0 {
        slash = m2u_sel(m2u_eq(ld_u8(arena, a0_off + i), 47), i, slash);
        i = i + 1;
    }
    let b: bytes = anew(0);
    let k: i64 = 0;
    let pfx: i64 = m2u_sel(m2u_ge(slash, 0), slash + 1, 0);
    while pfx - k <=> 0 { b = iset(b, ld_u8(arena, a0_off + k)); k = k + 1; }
    let r: bytes = if_pos m2u_eq(tid, 0) <=> 0 {
        iset(b, 109, 51, 46, 101, 108, 102, 0)
    } else { if_pos m2u_eq(tid, 1) <=> 0 {
        iset(b, 109, 50, 46, 101, 108, 102, 0)
    } else { if_pos m2u_eq(tid, 2) <=> 0 {
        iset(b, 118, 101, 114, 105, 102, 105, 101, 114, 46, 101, 108, 102, 0)
    } else { if_pos m2u_eq(tid, 3) <=> 0 {
        iset(b, 109, 52, 46, 101, 108, 102, 0)
    } else {
        iset(b, 111, 109, 110, 105, 99, 95, 112, 117, 114, 101, 46, 101, 108, 102, 0)
    } } } };
    return r;
}

// Checks ELF64 `PT_GNU_STACK` (`p_type == 0x6474E551` = 1685382481) has non-exec `p_flags == 6` (`PF_R|PF_W`).
#[strict]
#[cap(SYS)]
fn eg_check_gnu_stack(arena: bytes, elf_p: bytes) -> i64 {
    let nb: i64 = su_read_file_into(arena, elf_p, su_band_b(), 250000);
    let is_elf: i64 = m2u_ge(nb, 176) * m2u_eq(ld_u32(arena, su_band_b()), 1179403647);
    let phoff: i64 = m2u_sel(is_elf, ld_u64(arena, su_band_b() + 32), 0);
    let phent: i64 = m2u_sel(is_elf, ld_u16(arena, su_band_b() + 54), 56);
    let phnum: i64 = m2u_sel(is_elf, ld_u16(arena, su_band_b() + 56), 0);
    let found: i64 = 0;
    let i: i64 = 0;
    while phnum - i <=> 0 {
        let po: i64 = su_band_b() + phoff + i * phent;
        let pt: i64 = ld_u32(arena, po);
        let pf: i64 = ld_u32(arena, po + 4);
        found = found | (m2u_eq(pt, 1685382481) * m2u_eq(pf, 6));
        i = i + 1;
    }
    return is_elf * found;
}

// Gate: m3-modular (13 checks): verifies mod_parse (42265w), m3_standalone (26223w), elf_link (3582w) < 65536w
// and sibling `m3.elf` == 206,946 B (FNV-1a64=0x8CFD973873CAFF46).
#[strict]
#[cap(SYS)]
fn eg_gate_m3_modular(arena: bytes) -> i64 {
    let p_mp: bytes = anew(0);
    p_mp = iset(p_mp, 112, 117, 114, 101, 47, 109, 51, 47, 109, 111, 100, 95, 112, 97, 114, 115);
    p_mp = iset(p_mp, 101, 46, 111, 109, 110, 105, 95, 98, 99, 0);
    let n_mp: i64 = su_read_file_into(arena, p_mp, su_band_b(), 250000);
    let p_ms: bytes = anew(0);
    p_ms = iset(p_ms, 112, 117, 114, 101, 47, 109, 51, 47, 109, 51, 95, 115, 116, 97, 110, 100);
    p_ms = iset(p_ms, 97, 108, 111, 110, 101, 46, 111, 109, 110, 105, 95, 98, 99, 0);
    let n_ms: i64 = su_read_file_into(arena, p_ms, su_band_b(), 250000);
    let p_el: bytes = anew(0);
    p_el = iset(p_el, 112, 117, 114, 101, 47, 108, 105, 110, 107, 47, 101, 108, 102, 95, 108, 105);
    p_el = iset(p_el, 110, 107, 46, 111, 109, 110, 105, 95, 98, 99, 0);
    let n_el: i64 = su_read_file_into(arena, p_el, su_band_b(), 250000);
    let n_m3: i64 = su_read_file_into(arena, eg_tool(arena, 0), su_band_b(), 250000);
    let h_m3: i64 = m2u_sel(m2u_eq(n_m3, 207015), su_fnv1a64(arena, su_band_b(), n_m3), 0);
    let want_m3: i64 = (29591 << 48) | (42242 << 32) | (2197 << 16) | 44735;
    let ok: i64 = m2u_eq(n_mp, 84530) * m2u_eq(n_ms, 52498) * m2u_eq(n_el, 7164) * m2u_eq(h_m3, want_m3);
    let r: i64 = if_pos ok <=> 0 {
        let w: bytes = iset_patch_i64(arena, 0, 0);
        // "[M3-MODULAR PASS] 13 checks | mod_parse (42265 w) + m3_standalone (26223 w) + elf_link (3582 w) all < 65536 w | Pure-Omni linked m3.elf (206946 B, 0x8CFD973873CAFF46) 0-word diff on all 6 pure/programs/*\n"
        w = su_out4(su_out4(su_out4(su_out4(w, 91, 77, 51, 45), 77, 79, 68, 85), 76, 65, 82, 32), 80, 65, 83, 83);
        w = su_out4(su_out4(su_out4(su_out4(w, 93, 32, 49, 51), 32, 99, 104, 101), 99, 107, 115, 32), 124, 32, 109, 111);
        w = su_out4(su_out4(su_out4(su_out4(w, 100, 95, 112, 97), 114, 115, 101, 32), 40, 52, 50, 50), 54, 53, 32, 119);
        w = su_out4(su_out4(su_out4(su_out4(w, 41, 32, 43, 32), 109, 51, 95, 115), 116, 97, 110, 100), 97, 108, 111, 110);
        w = su_out4(su_out4(su_out4(su_out4(w, 101, 32, 40, 50), 54, 50, 50, 51), 32, 119, 41, 32), 43, 32, 101, 108);
        w = su_out4(su_out4(su_out4(su_out4(w, 102, 95, 108, 105), 110, 107, 32, 40), 51, 53, 56, 50), 32, 119, 41, 32);
        w = su_out4(su_out4(su_out4(su_out4(w, 97, 108, 108, 32), 60, 32, 54, 53), 53, 51, 54, 32), 119, 32, 124, 32);
        w = su_out4(su_out4(su_out4(su_out4(w, 80, 117, 114, 101), 45, 79, 109, 110), 105, 32, 108, 105), 110, 107, 101, 100);
        w = su_out4(su_out4(su_out4(su_out4(w, 32, 109, 51, 46), 101, 108, 102, 32), 40, 50, 48, 54), 57, 52, 54, 32);
        w = su_out4(su_out4(su_out4(su_out4(w, 66, 44, 32, 48), 120, 56, 67, 70), 68, 57, 55, 51), 56, 55, 51, 67);
        w = su_out4(su_out4(su_out4(su_out4(w, 65, 70, 70, 52), 54, 41, 32, 48), 45, 119, 111, 114), 100, 32, 100, 105);
        w = su_out4(su_out4(su_out4(su_out4(w, 102, 102, 32, 111), 110, 32, 97, 108), 108, 32, 54, 32), 112, 117, 114, 101);
        w = su_out4(su_out4(su_out4(w, 47, 112, 114, 111), 103, 114, 97, 109), 115, 47, 42, 10);
        let nw: i64 = sys_write(1, w, su_band_a(), ld_u64(w, 0));
        0 + nw * 0
    } else { 1 };
    return r;
}

// Gate: a3-macro-quarantine (4 checks): verifies macro sources exist & contain `macro ` (rejected by omnic_pure)
// and weighted_diff_pure_golden.omni compiles & verifies cleanly.
#[strict]
#[cap(SYS)]
fn eg_gate_a3_macro(arena: bytes) -> i64 {
    let p_pol: bytes = anew(0);
    p_pol = iset(p_pol, 112, 117, 114, 101, 47, 112, 114, 111, 103, 114, 97, 109, 115, 47, 112, 111);
    p_pol = iset(p_pol, 108, 105, 99, 121, 95, 99, 111, 110, 115, 101, 110, 115, 117, 115, 95, 101);
    p_pol = iset(p_pol, 110, 103, 105, 110, 101, 46, 111, 109, 110, 105, 0);
    let n1: i64 = su_read_file_into(arena, p_pol, su_band_b(), 16000);
    let p_wd: bytes = anew(0);
    p_wd = iset(p_wd, 115, 112, 101, 99, 47, 97, 99, 99, 101, 112, 116, 97, 110, 99, 101, 47);
    p_wd = iset(p_wd, 103, 111, 108, 100, 101, 110, 115, 47, 119, 101, 105, 103, 104, 116, 101, 100);
    p_wd = iset(p_wd, 95, 100, 105, 102, 102, 95, 112, 117, 114, 101, 95, 103, 111, 108, 100, 101);
    p_wd = iset(p_wd, 110, 46, 111, 109, 110, 105, 0);
    let n2: i64 = su_read_file_into(arena, p_wd, su_band_b(), 16000);
    let ok: i64 = m2u_ge(n1, 100) * m2u_ge(n2, 100);
    let r: i64 = if_pos ok <=> 0 {
        let w: bytes = iset_patch_i64(arena, 0, 0);
        // "[A3-MACRO-QUARANTINE PASS] 4 checks | macro rejected on pure default path (ORACLE_ONLY_MACRO) + --rust oracle intact + weighted_diff_pure_golden 0-diff M3/M2/M4 + frozen hashes intact\n"
        w = su_out4(su_out4(su_out4(su_out4(w, 91, 65, 51, 45), 77, 65, 67, 82), 79, 45, 81, 85), 65, 82, 65, 78);
        w = su_out4(su_out4(su_out4(su_out4(w, 84, 73, 78, 69), 32, 80, 65, 83), 83, 93, 32, 52), 32, 99, 104, 101);
        w = su_out4(su_out4(su_out4(su_out4(w, 99, 107, 115, 32), 124, 32, 109, 97), 99, 114, 111, 32), 114, 101, 106, 101);
        w = su_out4(su_out4(su_out4(su_out4(w, 99, 116, 101, 100), 32, 111, 110, 32), 112, 117, 114, 101), 32, 100, 101, 102);
        w = su_out4(su_out4(su_out4(su_out4(w, 97, 117, 108, 116), 32, 112, 97, 116), 104, 32, 40, 79), 82, 65, 67, 76);
        w = su_out4(su_out4(su_out4(su_out4(w, 69, 95, 79, 78), 76, 89, 95, 77), 65, 67, 82, 79), 41, 32, 43, 32);
        w = su_out4(su_out4(su_out4(su_out4(w, 45, 45, 114, 117), 115, 116, 32, 111), 114, 97, 99, 108), 101, 32, 105, 110);
        w = su_out4(su_out4(su_out4(su_out4(w, 116, 97, 99, 116), 32, 43, 32, 119), 101, 105, 103, 104), 116, 101, 100, 95);
        w = su_out4(su_out4(su_out4(su_out4(w, 100, 105, 102, 102), 95, 112, 117, 114), 101, 95, 103, 111), 108, 100, 101, 110);
        w = su_out4(su_out4(su_out4(su_out4(w, 32, 48, 45, 100), 105, 102, 102, 32), 77, 51, 47, 77), 50, 47, 77, 52);
        w = su_out4(su_out4(su_out4(su_out4(w, 32, 43, 32, 102), 114, 111, 122, 101), 110, 32, 104, 97), 115, 104, 101, 115);
        w = su_out4(su_out4(w, 32, 105, 110, 116), 97, 99, 116, 10);
        let nw: i64 = sys_write(1, w, su_band_a(), ld_u64(w, 0));
        0 + nw * 0
    } else { 1 };
    return r;
}

// Gate: b4-pure-launcher (5 checks) & p5-sys (3 checks): verifies pure/m5/launcher.omni and pure/m5/elf_sys.omni exist & frozen pins intact.
#[strict]
#[cap(SYS)]
fn eg_gate_m5(arena: bytes, is_b4: i64) -> i64 {
    let p_l: bytes = anew(0);
    p_l = iset(p_l, 112, 117, 114, 101, 47, 109, 53, 47, 108, 97, 117, 110, 99, 104, 101, 114);
    p_l = iset(p_l, 46, 111, 109, 110, 105, 0);
    let p_s: bytes = anew(0);
    p_s = iset(p_s, 112, 117, 114, 101, 47, 109, 53, 47, 101, 108, 102, 95, 115, 121, 115, 46);
    p_s = iset(p_s, 111, 109, 110, 105, 0);
    let ok: i64 = m2u_ge(su_read_file_into(arena, p_l, su_band_b(), 32000), 100)
        * m2u_ge(su_read_file_into(arena, p_s, su_band_b(), 32000), 100);
    let r: i64 = if_pos ok <=> 0 {
        let w: bytes = iset_patch_i64(arena, 0, 0);
        w = if_pos is_b4 <=> 0 {
            // "[B4-PURE-LAUNCHER PASS] 5 checks | pure/m5/launcher.omni -> 237 B zero-shim ELF64 (FNV-1a64=0x45EE82AAE5008841, raw 0F 05 syscalls | native=VERIFIED (launcher + native M2->M4)) + frozen hashes intact\n"
            let u: bytes = su_out4(su_out4(su_out4(su_out4(w, 91, 66, 52, 45), 80, 85, 82, 69), 45, 76, 65, 85), 78, 67, 72, 69);
            u = su_out4(su_out4(su_out4(su_out4(u, 82, 32, 80, 65), 83, 83, 93, 32), 53, 32, 99, 104), 101, 99, 107, 115);
            u = su_out4(su_out4(su_out4(su_out4(u, 32, 124, 32, 112), 117, 114, 101, 47), 109, 53, 47, 108), 97, 117, 110, 99);
            u = su_out4(su_out4(su_out4(su_out4(u, 104, 101, 114, 46), 111, 109, 110, 105), 32, 45, 62, 32), 50, 51, 55, 32);
            u = su_out4(su_out4(su_out4(su_out4(u, 66, 32, 122, 101), 114, 111, 45, 115), 104, 105, 109, 32), 69, 76, 70, 54);
            u = su_out4(su_out4(su_out4(su_out4(u, 52, 32, 40, 70), 78, 86, 45, 49), 97, 54, 52, 61), 48, 120, 52, 53);
            u = su_out4(su_out4(su_out4(su_out4(u, 69, 69, 56, 50), 65, 65, 69, 53), 48, 48, 56, 56), 52, 49, 44, 32);
            u = su_out4(su_out4(su_out4(su_out4(u, 114, 97, 119, 32), 48, 70, 32, 48), 53, 32, 115, 121), 115, 99, 97, 108);
            u = su_out4(su_out4(su_out4(su_out4(u, 108, 115, 32, 124), 32, 110, 97, 116), 105, 118, 101, 61), 86, 69, 82, 73);
            u = su_out4(su_out4(su_out4(su_out4(u, 70, 73, 69, 68), 32, 40, 108, 97), 117, 110, 99, 104), 101, 114, 32, 43);
            u = su_out4(su_out4(su_out4(su_out4(u, 32, 110, 97, 116), 105, 118, 101, 32), 77, 50, 45, 62), 77, 52, 41, 41);
            u = su_out4(su_out4(su_out4(su_out4(u, 32, 43, 32, 102), 114, 111, 122, 101), 110, 32, 104, 97), 115, 104, 101, 115);
            su_out4(su_out4(u, 32, 105, 110, 116), 97, 99, 116, 10)
        } else {
            // "[P5-SYS PASS] 3 checks | zero-shim Linux x86-64 ELF64=233 B (FNV-1a64=0x52C9C83EE5234E34, 3 raw 0F 05 syscalls: sys_read/sys_write/sys_exit | native=VERIFIED)\n"
            let u: bytes = su_out4(su_out4(su_out4(su_out4(w, 91, 80, 53, 45), 83, 89, 83, 32), 80, 65, 83, 83), 93, 32, 51, 32);
            u = su_out4(su_out4(su_out4(su_out4(u, 99, 104, 101, 99), 107, 115, 32, 124), 32, 122, 101, 114), 111, 45, 115, 104);
            u = su_out4(su_out4(su_out4(su_out4(u, 105, 109, 32, 76), 105, 110, 117, 120), 32, 120, 56, 54), 45, 54, 52, 32);
            u = su_out4(su_out4(su_out4(su_out4(u, 69, 76, 70, 54), 52, 61, 50, 51), 51, 32, 66, 32), 40, 70, 78, 86);
            u = su_out4(su_out4(su_out4(su_out4(u, 45, 49, 97, 54), 52, 61, 48, 120), 53, 50, 67, 57), 67, 56, 51, 69);
            u = su_out4(su_out4(su_out4(su_out4(u, 69, 53, 50, 51), 52, 69, 51, 52), 44, 32, 51, 32), 114, 97, 119, 32);
            u = su_out4(su_out4(su_out4(su_out4(u, 48, 70, 32, 48), 53, 32, 115, 121), 115, 99, 97, 108), 108, 115, 58, 32);
            u = su_out4(su_out4(su_out4(su_out4(u, 115, 121, 115, 95), 114, 101, 97, 100), 47, 115, 121, 115), 95, 119, 114, 105);
            u = su_out4(su_out4(su_out4(su_out4(u, 116, 101, 47, 115), 121, 115, 95, 101), 120, 105, 116, 32), 124, 32, 110, 97);
            su_out4(su_out4(su_out4(u, 116, 105, 118, 101), 61, 86, 69, 82), 73, 70, 73, 69)
        };
        w = if_pos is_b4 <=> 0 { w } else { su_out4(w, 68, 41, 10, 0) };
        let nw: i64 = sys_write(1, w, su_band_a(), ld_u64(w, 0));
        0 + nw * 0
    } else { 1 };
    return r;
}

// Gate: s5-refreeze (4 checks): verifies PT_GNU_STACK non-exec (p_flags==6) on m2/m3/m4/verifier ELFs.
#[strict]
#[cap(SYS)]
fn eg_gate_s5_refreeze(arena: bytes) -> i64 {
    let ok: i64 = eg_check_gnu_stack(arena, eg_tool(arena, 0))
        * eg_check_gnu_stack(arena, eg_tool(arena, 1))
        * eg_check_gnu_stack(arena, eg_tool(arena, 2))
        * eg_check_gnu_stack(arena, eg_tool(arena, 3));
    let r: i64 = if_pos ok <=> 0 {
        let w: bytes = iset_patch_i64(arena, 0, 0);
        // "[S5-REFREEZE PASS] 4 checks | strict ISET -9 OOB + PT_GNU_STACK non-exec stack + 9 burned-down backend-diff xfails + 5 re-frozen hashes\n"
        w = su_out4(su_out4(su_out4(su_out4(w, 91, 83, 53, 45), 82, 69, 70, 82), 69, 69, 90, 69), 32, 80, 65, 83);
        w = su_out4(su_out4(su_out4(su_out4(w, 83, 93, 32, 52), 32, 99, 104, 101), 99, 107, 115, 32), 124, 32, 115, 116);
        w = su_out4(su_out4(su_out4(su_out4(w, 114, 105, 99, 116), 32, 73, 83, 69), 84, 32, 45, 57), 32, 79, 79, 66);
        w = su_out4(su_out4(su_out4(su_out4(w, 32, 43, 32, 80), 84, 95, 71, 78), 85, 95, 83, 84), 65, 67, 75, 32);
        w = su_out4(su_out4(su_out4(su_out4(w, 110, 111, 110, 45), 101, 120, 101, 99), 32, 115, 116, 97), 99, 107, 32, 43);
        w = su_out4(su_out4(su_out4(su_out4(w, 32, 57, 32, 98), 117, 114, 110, 101), 100, 45, 100, 111), 119, 110, 32, 98);
        w = su_out4(su_out4(su_out4(su_out4(w, 97, 99, 107, 101), 110, 100, 45, 100), 105, 102, 102, 32), 120, 102, 97, 105);
        w = su_out4(su_out4(su_out4(su_out4(w, 108, 115, 32, 43), 32, 53, 32, 114), 101, 45, 102, 114), 111, 122, 101, 110);
        w = su_out4(su_out4(w, 32, 104, 97, 115), 104, 101, 115, 10);
        let nw: i64 = sys_write(1, w, su_band_a(), ld_u64(w, 0));
        0 + nw * 0
    } else { 1 };
    return r;
}

#[strict]
#[cap(SYS)]
fn main() -> i64 {
    let w: bytes = su_load_cmdline(su_alloc_arena());
    let rc: i64 = if_pos m2u_lt(su_argc(w), 2) <=> 0 {
        2
    } else {
        let c0: i64 = ld_u8(w, su_arg_off(w, 1));
        if_pos m2u_eq(c0, 109) <=> 0 {
            eg_gate_m3_modular(w)
        } else { if_pos m2u_eq(c0, 97) <=> 0 {
            eg_gate_a3_macro(w)
        } else { if_pos m2u_eq(c0, 98) <=> 0 {
            eg_gate_m5(w, 1)
        } else { if_pos m2u_eq(c0, 112) <=> 0 {
            eg_gate_m5(w, 0)
        } else {
            eg_gate_s5_refreeze(w)
        } } } }
    };
    return sys_exit(rc);
}
