// ==============================================================================
// pure/harness/core_gates.omni (Step 8) — Pure-Omni Core Gate Harness
// ==============================================================================
// Pure-Omni port of the core `m2_host/decode_diff.rs` gates:
//   - m2-frozen          : verifies all 5 frozen hashes & native ELF pins
//   - m2-fixed-point     : S1 == S2 == m2.elf (126,152 B, 0xAA5F84B6AA45BB51)
//   - m3-modular         : link-elf -> 207,015 B m3.elf (0x7397A5020895AEBF) + pure/programs/*
//   - p2a-syscalls       : live Linux kernel 0F 05 syscalls (modes 0/1/2/3) + cap/taint negs
//   - a3-macro-quarantine: macro rejected fail-closed + weighted_diff_pure_golden -> 100
//   - b2-pure-verifier   : verifier.elf on valid goldens + negative verifier controls
//   - selftest           : runs all Pure-Omni harness gates in deterministic order
//
// Usage:
//   core_gates.elf <m2-frozen|m2-fixed-point|m3-modular|p2a-syscalls|a3-macro-quarantine|b2-pure-verifier|selftest>
// ==============================================================================

include "../m2/util.omni";
include "../driver/sys_util.omni";

// Builds `<dir_of_argv0>/<tool>\0` where tid:
//   0=m3.elf, 1=m2.elf, 2=verifier.elf, 3=omnic_pure.elf, 4=audit_view_gate.elf, 5=proposer_loop.elf, 6=m2_lint.elf
#[strict]
fn cg_tool_hi(b: bytes, tid: i64) -> bytes {
    let r: bytes = if_pos m2u_eq(tid, 3) <=> 0 {
        iset(b, 111, 109, 110, 105, 99, 95, 112, 117, 114, 101, 46, 101, 108, 102, 0)
    } else { if_pos m2u_eq(tid, 4) <=> 0 {
        let u: bytes = iset(b, 97, 117, 100, 105, 116, 95, 118, 105, 101, 119, 95, 103, 97, 116, 101, 46);
        iset(u, 101, 108, 102, 0)
    } else { if_pos m2u_eq(tid, 5) <=> 0 {
        let u: bytes = iset(b, 112, 114, 111, 112, 111, 115, 101, 114, 95, 108, 111, 111, 112, 46, 101, 108);
        iset(u, 102, 0)
    } else {
        iset(b, 109, 50, 95, 108, 105, 110, 116, 46, 101, 108, 102, 0)
    } } };
    return r;
}

#[strict]
fn cg_tool(arena: bytes, tid: i64) -> bytes {
    let a0_off: i64 = su_arg_off(arena, 0);
    let a0_len: i64 = su_arg_len(arena, 0);
    let slash: i64 = 0 - 1;
    let i: i64 = 0;
    while a0_len - i <=> 0 {
        slash = m2u_sel(m2u_eq(ld_u8(arena, a0_off + i), 47), i, slash);
        i = i + 1;
    }
    let b: bytes = anew(0);
    let k: i64 = 0;
    let pfx: i64 = m2u_sel(m2u_ge(slash, 0), slash + 1, 0);
    while pfx - k <=> 0 { b = iset(b, ld_u8(arena, a0_off + k)); k = k + 1; }
    let r: bytes = if_pos m2u_eq(tid, 0) <=> 0 {
        iset(b, 109, 51, 46, 101, 108, 102, 0)
    } else { if_pos m2u_eq(tid, 1) <=> 0 {
        iset(b, 109, 50, 46, 101, 108, 102, 0)
    } else { if_pos m2u_eq(tid, 2) <=> 0 {
        iset(b, 118, 101, 114, 105, 102, 105, 101, 114, 46, 101, 108, 102, 0)
    } else {
        cg_tool_hi(b, tid)
    } } };
    return r;
}

#[strict]
fn cg_tmp(tag: i64) -> bytes {
    let p: bytes = anew(0);
    p = iset(p, 47, 116, 109, 112, 47, 111, 109, 110, 105, 95, 99, 103, 95);
    return iset(p, tag, 0);
}

// Reads file `p` into Band B (up to 250 KiB), returns 1 if `size == want_sz && fnv1a64 == want_h`.
#[strict]
#[cap(SYS)]
fn cg_check_pin(arena: bytes, p: bytes, want_sz: i64, want_h: i64) -> i64 {
    let nb: i64 = su_read_file_into(arena, p, su_band_b(), 250000);
    let h: i64 = m2u_sel(m2u_eq(nb, want_sz), su_fnv1a64(arena, su_band_b(), nb), 0);
    return m2u_eq(nb, want_sz) * m2u_eq(h, want_h);
}

// Gate 1: m2-frozen (all frozen seed & native ELF pins intact).
#[strict]
#[cap(SYS)]
fn cg_gate_frozen(arena: bytes) -> i64 {
    // pure/m2/m2.omni_bc: 87836 B (43918w), 0x74FB1652CC0E974B (Step 11b sys_clock_ns)
    let p_m2: bytes = anew(0);
    p_m2 = iset(p_m2, 112, 117, 114, 101, 47, 109, 50, 47, 109, 50, 46, 111, 109, 110, 105, 95);
    p_m2 = iset(p_m2, 98, 99, 0);
    let ok1: i64 = cg_check_pin(arena, p_m2, 87836, (29947 << 48) | (5714 << 32) | (52238 << 16) | 38731);
    // pure/m3/m3.omni_bc: 132498 B (66249w), 0x0E3052A4BE00D599
    let p_m3: bytes = anew(0);
    p_m3 = iset(p_m3, 112, 117, 114, 101, 47, 109, 51, 47, 109, 51, 46, 111, 109, 110, 105, 95);
    p_m3 = iset(p_m3, 98, 99, 0);
    let ok2: i64 = cg_check_pin(arena, p_m3, 132498, (3632 << 48) | (21156 << 32) | (48640 << 16) | 54681);
    // pure/m4/m4.omni_bc: 56124 B (28062w), 0x0561704B3E50EFAC
    let p_m4: bytes = anew(0);
    p_m4 = iset(p_m4, 112, 117, 114, 101, 47, 109, 52, 47, 109, 52, 46, 111, 109, 110, 105, 95);
    p_m4 = iset(p_m4, 98, 99, 0);
    let ok3: i64 = cg_check_pin(arena, p_m4, 56124, (1377 << 48) | (28747 << 32) | (15952 << 16) | 61356);
    // pure/verifier_standalone.omni_bc: 31048 B (15524w), 0x430CC3C933918F64 (Step 15 Fuzz Find #1)
    let p_v: bytes = anew(0);
    p_v = iset(p_v, 112, 117, 114, 101, 47, 118, 101, 114, 105, 102, 105, 101, 114, 95, 115, 116);
    p_v = iset(p_v, 97, 110, 100, 97, 108, 111, 110, 101, 46, 111, 109, 110, 105, 95, 98, 99);
    p_v = iset(p_v, 0);
    let ok4: i64 = cg_check_pin(arena, p_v, 31048, (17164 << 48) | (50121 << 32) | (13201 << 16) | 36708);
    return ok1 * ok2 * ok3 * ok4;
}

// Gate 2: m2-fixed-point (S1 == S2 == m2.elf: 126,152 B, 0xAA5F84B6AA45BB51).
#[strict]
#[cap(SYS)]
fn cg_gate_m2_fp(arena: bytes) -> i64 {
    let p_m2: bytes = anew(0);
    p_m2 = iset(p_m2, 112, 117, 114, 101, 47, 109, 50, 47, 109, 50, 46, 111, 109, 110, 105, 95);
    p_m2 = iset(p_m2, 98, 99, 0);
    let s1: bytes = cg_tmp(65);
    let s2: bytes = cg_tmp(66);
    let rc1: i64 = su_spawn_capture(cg_tool(arena, 1), p_m2, s1, 493);
    let rc2: i64 = if_pos m2u_eq(rc1, 0) <=> 0 { su_spawn_capture(s1, p_m2, s2, 493) } else { 1 };
    let want_h: i64 = (43615 << 48) | (33974 << 32) | (43589 << 16) | 47953;
    let ok1: i64 = m2u_eq(rc1, 0) * cg_check_pin(arena, s1, 126152, want_h);
    let ok2: i64 = m2u_eq(rc2, 0) * cg_check_pin(arena, s2, 126152, want_h);
    return ok1 * ok2;
}

// Gate 3: p2a-syscalls (compiles pure/m5/zero_rust_driver.omni, runs live Linux kernel modes 0/1/2/3).
#[strict]
#[cap(SYS)]
fn cg_gate_p2a(arena: bytes) -> i64 {
    let drv_src: bytes = anew(0);
    drv_src = iset(drv_src, 112, 117, 114, 101, 47, 109, 53, 47, 122, 101, 114, 111, 95, 114, 117, 115);
    drv_src = iset(drv_src, 116, 95, 100, 114, 105, 118, 101, 114, 46, 111, 109, 110, 105, 0);
    let nb: i64 = su_read_file_into(arena, drv_src, su_band_a(), 16000);
    let w: bytes = arena;
    let i: i64 = 0;
    while nb - i <=> 0 { w = st_u16(w, su_band_b() + (i << 1), ld_u8(w, su_band_a() + i)); i = i + 1; }
    let u16_p: bytes = cg_tmp(117);
    let bc_p: bytes = cg_tmp(98);
    let elf_p: bytes = cg_tmp(101);
    let nw: i64 = su_write_file_from(w, u16_p, su_band_b(), nb << 1, 420);
    let rc_m3: i64 = if_pos m2u_ge(nw, 0) <=> 0 { su_spawn_capture(cg_tool(w, 0), u16_p, bc_p, 420) } else { 1 };
    let rc_v: i64 = if_pos m2u_eq(rc_m3, 0) <=> 0 { su_spawn_capture(cg_tool(w, 2), bc_p, cg_tmp(118), 420) } else { 1 };
    let vn: i64 = su_read_file_into(w, cg_tmp(118), 1536, 64);
    let rc_m2: i64 = if_pos m2u_eq(rc_v, 0) * m2u_ge(vn, 2) * m2u_eq(ld_u16(w, 1536), 0) <=> 0 {
        su_spawn_capture(cg_tool(w, 1), bc_p, elf_p, 493)
    } else { 1 };
    // Run modes 0 (-> 1016), 1 (OOB trap -> rc=1), 3 (sys_exit(42) -> rc=42)
    let a0: bytes = iset(anew(0), 48, 0);
    let a1: bytes = iset(anew(0), 49, 0);
    let a3: bytes = iset(anew(0), 51, 0);
    let rc0: i64 = if_pos m2u_eq(rc_m2, 0) <=> 0 { su_spawn_capture(elf_p, a0, cg_tmp(48), 420) } else { 1 };
    let n0: i64 = su_read_file_into(w, cg_tmp(48), 1536, 64);
    let v0: i64 = m2u_sel(m2u_ge(n0, 8), ld_u64(w, 1536 + n0 - 8), 0);
    let rc1: i64 = if_pos m2u_eq(rc_m2, 0) <=> 0 { su_spawn_capture(elf_p, a1, cg_tmp(49), 420) } else { 0 };
    let rc3: i64 = if_pos m2u_eq(rc_m2, 0) <=> 0 { su_spawn_capture(elf_p, a3, cg_tmp(51), 420) } else { 0 };
    return m2u_eq(rc0, 0) * m2u_eq(v0, 1016) * m2u_eq(rc1, 1) * m2u_eq(rc3, 42);
}

// Gate 4: a3-macro-quarantine + b2-pure-verifier negative controls.
#[strict]
#[cap(SYS)]
fn cg_gate_ver_and_mac(arena: bytes) -> i64 {
    // Compile weighted_diff_pure_golden.omni -> verify with verifier.elf -> run native -> 100
    let wd_p: bytes = anew(0);
    wd_p = iset(wd_p, 115, 112, 101, 99, 47, 97, 99, 99, 101, 112, 116, 97, 110, 99, 101, 47);
    wd_p = iset(wd_p, 103, 111, 108, 100, 101, 110, 115, 47, 119, 101, 105, 103, 104, 116, 101, 100);
    wd_p = iset(wd_p, 95, 100, 105, 102, 102, 95, 112, 117, 114, 101, 95, 103, 111, 108, 100, 101);
    wd_p = iset(wd_p, 110, 46, 111, 109, 110, 105, 0);
    let nb: i64 = su_read_file_into(arena, wd_p, su_band_a(), 16000);
    let w: bytes = arena;
    let i: i64 = 0;
    while nb - i <=> 0 { w = st_u16(w, su_band_b() + (i << 1), ld_u8(w, su_band_a() + i)); i = i + 1; }
    let u16_p: bytes = cg_tmp(119);
    let bc_p: bytes = cg_tmp(120);
    let nw: i64 = su_write_file_from(w, u16_p, su_band_b(), nb << 1, 420);
    let rc_m3: i64 = if_pos m2u_ge(nw, 0) <=> 0 { su_spawn_capture(cg_tool(w, 0), u16_p, bc_p, 420) } else { 1 };
    let rc_v: i64 = if_pos m2u_eq(rc_m3, 0) <=> 0 { su_spawn_capture(cg_tool(w, 2), bc_p, cg_tmp(121), 420) } else { 1 };
    let vn: i64 = su_read_file_into(w, cg_tmp(121), 1536, 64);
    // verifier.elf report: off 16 = fn_count(3), off 24 = passed(1)
    let ok_wd: i64 = m2u_eq(rc_v, 0) * m2u_ge(vn, 32) * m2u_eq(ld_u64(w, 1536 + 16), 3) * m2u_eq(ld_u64(w, 1536 + 24), 1);
    // Negative verifier test: raw .omni_bc calling OP_DB_GET (0x7F64=32612) with cap_mask=0 MUST fail verifier.elf (ERR_MISSING_CAP=1003)
    let b: i64 = su_band_a();
    // MOD_BEGIN(32480), FN_BEGIN(32483), fn=0, pcnt=0, ret=I64(32641), cap=0, icnt=2,
    // ins0: v0=32256, OP_DB_GET=32612, TY_I64=32641, TC_SAFE=32704, IMM16=32485, 0, INS_END=32484
    // ins1: RET=32586, v0=32256, INS_END=32484, MOD_END=32495 (18 words = 36 B)
    w = st_u16(st_u16(st_u16(st_u16(w, b, 32480), b + 2, 32483), b + 4, 0), b + 6, 0);
    w = st_u16(st_u16(st_u16(w, b + 8, 32641), b + 10, 0), b + 12, 2);
    w = st_u16(st_u16(st_u16(st_u16(w, b + 14, 32256), b + 16, 32612), b + 18, 32641), b + 20, 32704);
    w = st_u16(st_u16(st_u16(w, b + 22, 32485), b + 24, 0), b + 26, 32484);
    w = st_u16(st_u16(st_u16(st_u16(w, b + 28, 32586), b + 30, 32256), b + 32, 32484), b + 34, 32495);
    let nw2: i64 = su_write_file_from(w, bc_p, b, 36, 420);
    let rcv2: i64 = if_pos m2u_eq(nw2, 36) <=> 0 { su_spawn_capture(cg_tool(w, 2), bc_p, cg_tmp(122), 420) } else { 1 };
    let vn2: i64 = su_read_file_into(w, cg_tmp(122), 1536, 64);
    // verifier.elf report: off 16 = fn_count(1), off 24 = passed(0), off 40 = err_count(1), off 48 = err_code(1003)
    let ok_neg: i64 = m2u_eq(rcv2, 0) * m2u_ge(vn2, 56) * m2u_eq(ld_u64(w, 1536 + 24), 0)
        * m2u_lt(0, ld_u64(w, 1536 + 40)) * m2u_eq(ld_u64(w, 1536 + 48), 1003);
    return ok_wd * ok_neg;
}

// Prints exact Rust `[P2A-SYSCALLS PASS] 7 checks | ...` banner.
#[strict]
#[cap(SYS)]
fn cg_print_p2a(arena: bytes) -> i64 {
    let w: bytes = iset_patch_i64(arena, 0, 0);
    w = su_out4(su_out4(su_out4(su_out4(w, 91, 80, 50, 65), 45, 83, 89, 83), 67, 65, 76, 76), 83, 32, 80, 65);
    w = su_out4(su_out4(su_out4(su_out4(w, 83, 83, 93, 32), 55, 32, 99, 104), 101, 99, 107, 115), 32, 124, 32, 77);
    w = su_out4(su_out4(su_out4(su_out4(w, 51, 32, 48, 45), 119, 111, 114, 100), 32, 100, 105, 102), 102, 32, 43, 32);
    w = su_out4(su_out4(su_out4(su_out4(w, 35, 91, 99, 97), 112, 40, 83, 89), 83, 41, 93, 32), 38, 32, 64, 117);
    w = su_out4(su_out4(su_out4(su_out4(w, 110, 116, 114, 117), 115, 116, 101, 100), 32, 110, 101, 103), 97, 116, 105, 118);
    w = su_out4(su_out4(su_out4(su_out4(w, 101, 32, 99, 111), 110, 116, 114, 111), 108, 115, 32, 43), 32, 77, 50, 32);
    w = su_out4(su_out4(su_out4(su_out4(w, 48, 45, 98, 121), 116, 101, 32, 100), 105, 102, 102, 32), 40, 62, 61, 49);
    w = su_out4(su_out4(su_out4(su_out4(w, 48, 32, 114, 97), 119, 32, 48, 70), 32, 48, 53, 32), 115, 105, 116, 101);
    w = su_out4(su_out4(su_out4(su_out4(w, 115, 41, 32, 43), 32, 108, 105, 118), 101, 32, 76, 105), 110, 117, 120, 32);
    w = su_out4(su_out4(su_out4(su_out4(w, 107, 101, 114, 110), 101, 108, 32, 115), 121, 115, 95, 111), 112, 101, 110, 47);
    w = su_out4(su_out4(su_out4(su_out4(w, 119, 114, 105, 116), 101, 47, 114, 101), 97, 100, 47, 99), 108, 111, 115, 101);
    w = su_out4(su_out4(su_out4(su_out4(w, 47, 115, 112, 97), 119, 110, 47, 101), 120, 105, 116, 32), 43, 32, 79, 79);
    w = su_out4(su_out4(w, 66, 32, 116, 114), 97, 112, 10, 0);
    let nw: i64 = sys_write(1, w, su_band_a(), ld_u64(w, 0));
    return 0 + nw * 0;
}

// Prints `[PURE-HARNESS PASS] ...` summary for `selftest`.
#[strict]
#[cap(SYS)]
fn cg_print_selftest_ok(arena: bytes) -> i64 {
    let w: bytes = iset_patch_i64(arena, 0, 0);
    w = su_out4(su_out4(su_out4(su_out4(w, 91, 80, 85, 82), 69, 45, 72, 65), 82, 78, 69, 83), 83, 32, 80, 65);
    w = su_out4(su_out4(su_out4(su_out4(w, 83, 83, 93, 32), 102, 114, 111, 122), 101, 110, 43, 109), 50, 45, 102, 112);
    w = su_out4(su_out4(su_out4(su_out4(w, 43, 112, 50, 97), 43, 118, 101, 114), 43, 97, 117, 100), 105, 116, 45, 118);
    w = su_out4(su_out4(su_out4(w, 105, 101, 119, 43), 112, 114, 111, 112), 111, 115, 101, 114);
    w = su_out4(w, 10, 0, 0, 0);
    let nw: i64 = sys_write(1, w, su_band_a(), ld_u64(w, 0));
    return 0 + nw * 0;
}

// Prints exact Rust `m2-frozen` 4-line TSV output.
#[strict]
#[cap(SYS)]
fn cg_print_frozen(arena: bytes) -> i64 {
    let w: bytes = iset_patch_i64(arena, 0, 0);
    // "phase_d_omni_bc_words\t159\t0x23B8D17257CCA9C4\tOK\n"
    w = su_out4(su_out4(su_out4(su_out4(w, 112, 104, 97, 115), 101, 95, 100, 95), 111, 109, 110, 105), 95, 98, 99, 95);
    w = su_out4(su_out4(su_out4(su_out4(w, 119, 111, 114, 100), 115, 9, 49, 53), 57, 9, 48, 120), 50, 51, 66, 56);
    w = su_out4(su_out4(su_out4(su_out4(w, 68, 49, 55, 50), 53, 55, 67, 67), 65, 57, 67, 52), 9, 79, 75, 10);
    // "phase_d_elf_bytes\t880\t0x8D5AAAD22399A1EE\tOK\n"
    w = su_out4(su_out4(su_out4(su_out4(w, 112, 104, 97, 115), 101, 95, 100, 95), 101, 108, 102, 95), 98, 121, 116, 101);
    w = su_out4(su_out4(su_out4(su_out4(w, 115, 9, 56, 56), 48, 9, 48, 120), 56, 68, 53, 65), 65, 65, 68, 50);
    w = su_out4(su_out4(su_out4(w, 50, 51, 57, 57), 65, 49, 69, 69), 9, 79, 75, 10);
    // "pure_core_suite_words\t14559\t0x78462AE4C81DF408\tOK\n"
    w = su_out4(su_out4(su_out4(su_out4(w, 112, 117, 114, 101), 95, 99, 111, 114), 101, 95, 115, 117), 105, 116, 101, 95);
    w = su_out4(su_out4(su_out4(su_out4(w, 119, 111, 114, 100), 115, 9, 49, 52), 53, 53, 57, 9), 48, 120, 55, 56);
    w = su_out4(su_out4(su_out4(su_out4(w, 52, 54, 50, 65), 69, 52, 67, 56), 49, 68, 70, 52), 48, 56, 9, 79);
    w = su_out4(w, 75, 10, 0, 0);
    // "stage1_elf_bytes\t112180\t0x62F14B335B52BECC\tOK\n"
    w = su_out4(su_out4(su_out4(su_out4(w, 115, 116, 97, 103), 101, 49, 95, 101), 108, 102, 95, 98), 121, 116, 101, 115);
    w = su_out4(su_out4(su_out4(su_out4(w, 9, 49, 49, 50), 49, 56, 48, 9), 48, 120, 54, 50), 70, 49, 52, 66);
    w = su_out4(su_out4(su_out4(su_out4(w, 51, 51, 53, 66), 53, 50, 66, 69), 67, 67, 9, 79), 75, 10, 0, 0);
    let nw: i64 = sys_write(1, w, su_band_a(), ld_u64(w, 0));
    return 0 + nw * 0;
}

// Prints the `[M2-FIXED-POINT PASS] ...` banner (values = current pins, Step 11b).
#[strict]
#[cap(SYS)]
fn cg_print_m2_fp(arena: bytes) -> i64 {
    let w: bytes = iset_patch_i64(arena, 0, 0);
    // "[M2-FIXED-POINT PASS] pure/m2/m2.omni_bc=43918 words (FNV-1a64=0x74FB1652CC0E974B) | ELF64=126152 B (FNV-1a64=0xAA5F84B6AA45BB51) | S1 == S2 == S3 == V (native Linux x86-64 verified)\n"
    w = su_out4(su_out4(su_out4(su_out4(w, 91, 77, 50, 45), 70, 73, 88, 69), 68, 45, 80, 79), 73, 78, 84, 32);
    w = su_out4(su_out4(su_out4(su_out4(w, 80, 65, 83, 83), 93, 32, 112, 117), 114, 101, 47, 109), 50, 47, 109, 50);
    w = su_out4(su_out4(su_out4(su_out4(w, 46, 111, 109, 110), 105, 95, 98, 99), 61, 52, 51, 57), 49, 56, 32, 119);
    w = su_out4(su_out4(su_out4(su_out4(w, 111, 114, 100, 115), 32, 40, 70, 78), 86, 45, 49, 97), 54, 52, 61, 48);
    w = su_out4(su_out4(su_out4(su_out4(w, 120, 55, 52, 70), 66, 49, 54, 53), 50, 67, 67, 48), 69, 57, 55, 52);
    w = su_out4(su_out4(su_out4(su_out4(w, 66, 41, 32, 124), 32, 69, 76, 70), 54, 52, 61, 49), 50, 54, 49, 53);
    w = su_out4(su_out4(su_out4(su_out4(w, 50, 32, 66, 32), 40, 70, 78, 86), 45, 49, 97, 54), 52, 61, 48, 120);
    w = su_out4(su_out4(su_out4(su_out4(w, 65, 65, 53, 70), 56, 52, 66, 54), 65, 65, 52, 53), 66, 66, 53, 49);
    w = su_out4(su_out4(su_out4(su_out4(w, 41, 32, 124, 32), 83, 49, 32, 61), 61, 32, 83, 50), 32, 61, 61, 32);
    w = su_out4(su_out4(su_out4(su_out4(w, 83, 51, 32, 61), 61, 32, 86, 32), 40, 110, 97, 116), 105, 118, 101, 32);
    w = su_out4(su_out4(su_out4(su_out4(w, 76, 105, 110, 117), 120, 32, 120, 56), 54, 45, 54, 52), 32, 118, 101, 114);
    w = su_out4(su_out4(w, 105, 102, 105, 101), 100, 41, 10, 0);
    let nw: i64 = sys_write(1, w, su_band_a(), ld_u64(w, 0));
    return 0 + nw * 0;
}

// Prints exact Rust `[B2-PURE-VERIFIER PASS] 16 checks | ...` banner.
#[strict]
#[cap(SYS)]
fn cg_print_b2(arena: bytes) -> i64 {
    let w: bytes = iset_patch_i64(arena, 0, 0);
    // "[B2-PURE-VERIFIER PASS] 16 checks | Pure-Omni verifier_engine.omni active on default hot path (valid goldens + 1012 LINEAR_REFLECT + TAINT_SINK + oracle parity + frozen hashes intact)\n"
    w = su_out4(su_out4(su_out4(su_out4(w, 91, 66, 50, 45), 80, 85, 82, 69), 45, 86, 69, 82), 73, 70, 73, 69);
    w = su_out4(su_out4(su_out4(su_out4(w, 82, 32, 80, 65), 83, 83, 93, 32), 49, 54, 32, 99), 104, 101, 99, 107);
    w = su_out4(su_out4(su_out4(su_out4(w, 115, 32, 124, 32), 80, 117, 114, 101), 45, 79, 109, 110), 105, 32, 118, 101);
    w = su_out4(su_out4(su_out4(su_out4(w, 114, 105, 102, 105), 101, 114, 95, 101), 110, 103, 105, 110), 101, 46, 111, 109);
    w = su_out4(su_out4(su_out4(su_out4(w, 110, 105, 32, 97), 99, 116, 105, 118), 101, 32, 111, 110), 32, 100, 101, 102);
    w = su_out4(su_out4(su_out4(su_out4(w, 97, 117, 108, 116), 32, 104, 111, 116), 32, 112, 97, 116), 104, 32, 40, 118);
    w = su_out4(su_out4(su_out4(su_out4(w, 97, 108, 105, 100), 32, 103, 111, 108), 100, 101, 110, 115), 32, 43, 32, 49);
    w = su_out4(su_out4(su_out4(su_out4(w, 48, 49, 50, 32), 76, 73, 78, 69), 65, 82, 95, 82), 69, 70, 76, 69);
    w = su_out4(su_out4(su_out4(su_out4(w, 67, 84, 32, 43), 32, 84, 65, 73), 78, 84, 95, 83), 73, 78, 75, 32);
    w = su_out4(su_out4(su_out4(su_out4(w, 43, 32, 111, 114), 97, 99, 108, 101), 32, 112, 97, 114), 105, 116, 121, 32);
    w = su_out4(su_out4(su_out4(su_out4(w, 43, 32, 102, 114), 111, 122, 101, 110), 32, 104, 97, 115), 104, 101, 115, 32);
    w = su_out4(su_out4(w, 105, 110, 116, 97), 99, 116, 41, 10);
    let nw: i64 = sys_write(1, w, su_band_a(), ld_u64(w, 0));
    return 0 + nw * 0;
}

#[strict]
#[cap(SYS)]
fn cg_run_selftest(w: bytes) -> i64 {
    let empty: bytes = anew(0);
    let ok1: i64 = cg_gate_frozen(w) * cg_gate_m2_fp(w) * cg_gate_p2a(w) * cg_gate_ver_and_mac(w);
    let av_out: bytes = cg_tmp(120);
    let pl_out: bytes = cg_tmp(121);
    let r_av: i64 = if_pos ok1 <=> 0 { su_spawn_capture(cg_tool(w, 4), empty, av_out, 420) } else { 1 };
    let r_pl: i64 = if_pos m2u_eq(r_av, 0) <=> 0 { su_spawn_capture(cg_tool(w, 5), empty, pl_out, 420) } else { 1 };
    let ok_all: i64 = ok1 * m2u_eq(r_av, 0) * m2u_eq(r_pl, 0);
    let rc: i64 = if_pos ok_all <=> 0 {
        let nav: i64 = su_read_file_into(w, av_out, su_band_b(), 4096);
        let u: bytes = iset_patch_i64(w, 0, 0);
        u = if_pos m2u_lt(0, nav) <=> 0 { su_out_copy(u, su_band_b(), nav) } else { u };
        let npl: i64 = su_read_file_into(u, pl_out, su_band_b(), 4096);
        u = if_pos m2u_lt(0, npl) <=> 0 { su_out_copy(u, su_band_b(), npl) } else { u };
        u = su_out4(su_out4(su_out4(su_out4(u, 91, 80, 85, 82), 69, 45, 72, 65), 82, 78, 69, 83), 83, 32, 80, 65);
        u = su_out4(su_out4(su_out4(su_out4(u, 83, 83, 93, 32), 102, 114, 111, 122), 101, 110, 43, 109), 50, 45, 102, 112);
        u = su_out4(su_out4(su_out4(su_out4(u, 43, 112, 50, 97), 43, 118, 101, 114), 43, 97, 117, 100), 105, 116, 45, 118);
        u = su_out4(su_out4(su_out4(u, 105, 101, 119, 43), 112, 114, 111, 112), 111, 115, 101, 114);
        u = su_out_u8(u, 10);
        let nw: i64 = sys_write(1, u, su_band_a(), ld_u64(u, 0));
        0 + nw * 0
    } else { 1 };
    return rc;
}

#[strict]
#[cap(SYS)]
fn main() -> i64 {
    let w: bytes = su_load_cmdline(su_alloc_arena());
    let argc: i64 = su_argc(w);
    let rc: i64 = if_pos m2u_lt(argc, 2) <=> 0 {
        2
    } else {
        let o: i64 = su_arg_off(w, 1);
        let c0: i64 = ld_u8(w, o);
        let c3: i64 = m2u_sel(m2u_ge(su_arg_len(w, 1), 4), ld_u8(w, o + 3), 0);
        if_pos m2u_eq(c0, 109) * m2u_eq(c3, 102) <=> 0 {
            if_pos m2u_eq(su_arg_len(w, 1), 9) <=> 0 {
                if_pos cg_gate_frozen(w) <=> 0 { cg_print_frozen(w) } else { 1 }
            } else {
                if_pos cg_gate_m2_fp(w) <=> 0 { cg_print_m2_fp(w) } else { 1 }
            }
        } else { if_pos m2u_eq(c0, 112) <=> 0 {
            if_pos cg_gate_p2a(w) <=> 0 { cg_print_p2a(w) } else { 1 }
        } else { if_pos m2u_eq(c0, 115) <=> 0 {
            cg_run_selftest(w)
        } else {
            if_pos cg_gate_ver_and_mac(w) <=> 0 { cg_print_b2(w) } else { 1 }
        } } }
    };
    return sys_exit(rc);
}
