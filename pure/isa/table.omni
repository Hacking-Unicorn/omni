}

#[strict]
fn isa_op_count(x: i64) -> i64 {
    return 128;
}

#[strict]
fn isa_mn_count(x: i64) -> i64 {
    return 81;
}

#[strict]
fn isa_tbl_build(x: i64) -> bytes {
    let t: bytes = isa_tbl_append(anew(0));
    return t;
}

#[strict]
fn isa_is_eq(a: i64, b: i64) -> i64 {
    let c: trit = a <=> b;
    let r: i64 = sel_trit(c, 0, 1, 0);
    return r;
}

#[strict]
fn isa_is_lt(a: i64, b: i64) -> i64 {
    let c: trit = a <=> b;
    let r: i64 = sel_trit(c, 1, 0, 0);
    return r;
}

#[strict]
fn isa_u16_at(t: bytes, off: i64) -> i64 {
    let v: i64 = ld_u16(t, off);
    return v;
}

#[strict]
fn isa_op_index(tok: i64) -> i64 {
    let i: i64 = tok - 32512;
    let ok: i64 = (1 - isa_is_lt(i, 0)) * isa_is_lt(i, 128);
    let r: i64 = ok * i + (1 - ok) * (0 - 1);
    return r;
}

#[strict]
fn isa_op_rec(b: i64, i: i64) -> i64 {
    let v: i64 = b + 1296 + i * 8;
    return v;
}

#[strict]
fn isa_op_tok(t: bytes, b: i64, i: i64) -> i64 {
    let v: i64 = isa_u16_at(t, isa_op_rec(b, i));
    return v;
}

#[strict]
fn isa_op_cap(t: bytes, b: i64, i: i64) -> i64 {
    let v: i64 = isa_u16_at(t, isa_op_rec(b, i) + 2);
    return v;
}

#[strict]
fn isa_op_flags(t: bytes, b: i64, i: i64) -> i64 {
    let v: i64 = ld_u8(t, isa_op_rec(b, i) + 4);
    return v;
}

#[strict]
fn isa_op_flag(t: bytes, b: i64, i: i64, bit: i64) -> i64 {
    let f: i64 = isa_op_flags(t, b, i);
    let v: i64 = (f >> bit) & 1;
    return v;
}

#[strict]
fn isa_mn_rec(b: i64, m: i64) -> i64 {
    let v: i64 = b + m * 16;
    return v;
}

#[strict]
fn isa_mn_op(t: bytes, b: i64, m: i64) -> i64 {
    let v: i64 = 32512 + ld_u8(t, isa_mn_rec(b, m));
    return v;
}

#[strict]
fn isa_mn_tyb(t: bytes, b: i64, m: i64) -> i64 {
    let v: i64 = ld_u8(t, isa_mn_rec(b, m) + 1);
    return v;
}

#[strict]
fn isa_mn_shape(t: bytes, b: i64, m: i64) -> i64 {
    let y: i64 = isa_mn_tyb(t, b, m);
    let s: i64 = (1 - isa_is_lt(y, 240)) * isa_is_lt(y, 255);
    let v: i64 = s * (y - 239);
    return v;
}

#[strict]
fn isa_mn_ty(t: bytes, b: i64, m: i64, ret_ty: i64) -> i64 {
    let y: i64 = isa_mn_tyb(t, b, m);
    let fixed: i64 = isa_is_lt(y, 240);
    let from_ret: i64 = isa_is_eq(y, 255);
    let v: i64 = fixed * (32640 + y) + from_ret * ret_ty;
    return v;
}

#[strict]
fn isa_mn_len(t: bytes, b: i64, m: i64) -> i64 {
    let v: i64 = ld_u8(t, isa_mn_rec(b, m) + 2);
    return v;
}

#[strict]
fn isa_mn_ch(t: bytes, b: i64, m: i64, k: i64) -> i64 {
    let v: i64 = ld_u8(t, isa_mn_rec(b, m) + 3 + k);
    return v;
}

#[strict]
fn isa_mn_eq(t: bytes, b: i64, m: i64, s: bytes, off: i64, len: i64) -> i64 {
    let ok: i64 = isa_is_eq(isa_mn_len(t, b, m), len);
    let n: i64 = ok * len;
    let k: i64 = 0;
    while n - k <=> 0 {
        ok = ok * isa_is_eq(isa_mn_ch(t, b, m, k), ld_u8(s, off + k));
        k = k + 1;
    }
    return ok;
}

#[strict]
fn isa_mn_find(t: bytes, b: i64, s: bytes, off: i64, len: i64) -> i64 {
    let r: i64 = 0 - 1;
    let m: i64 = 81;
    while m <=> 0 {
        m = m - 1;
        let hit: i64 = isa_mn_eq(t, b, m, s, off, len);
        r = hit * m + (1 - hit) * r;
    }
    return r;
}
