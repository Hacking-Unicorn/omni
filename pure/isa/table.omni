    t = isa_mn_rows_0(t);
    t = isa_mn_rows_1(t);
    t = isa_mn_rows_2(t);
    t = isa_mn_rows_3(t);
    t = isa_mn_rows_4(t);
    t = isa_mn_rows_5(t);
    t = isa_mn_rows_6(t);
    t = isa_mn_rows_7(t);
    t = isa_op_rows_0(t);
    t = isa_op_rows_1(t);
    t = isa_op_rows_2(t);
    t = isa_op_rows_3(t);
    t = isa_op_rows_4(t);
    t = isa_op_rows_5(t);
    t = isa_op_rows_6(t);
    t = isa_op_rows_7(t);
    return t;
}

